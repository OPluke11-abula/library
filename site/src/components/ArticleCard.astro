---
import type { ArticleData } from '../lib/library';
import Icon from './Icon.astro';

interface Props {
  article: ArticleData;
  lang: 'zh' | 'en';
}

const { article, lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const articleUrl = `${base}/${lang}/notes/${article.slug}/`;
---

<article class="article-card" data-tags={article.tags.join(',')} data-hall={article.hall.code} data-callno={article.callNumber}>
  <div class="card-header">
    <div class="card-meta-left">
      <span class="callno-pill">{article.callNumber}</span>
      <span class={`badge-status status-${article.status.toLowerCase().replace(/\s+/g, '-')}`}>
        {article.status}
      </span>
    </div>
    <div class="hall-badge" title={lang === 'zh' ? article.hall.nameZh : article.hall.nameEn}>
      <Icon name={article.hall.iconName} size={13} />
      <span class="hall-text">{lang === 'zh' ? article.hall.nameZh : article.hall.nameEn}</span>
    </div>
  </div>

  <h3 class="card-title">
    <a href={articleUrl}>{article.title}</a>
  </h3>

  <p class="card-excerpt">{article.excerpt}</p>

  <div class="card-footer">
    <div class="rules-counter" title="System Invariants Defined">
      <Icon name="shield-check" size={13} />
      <span>{article.invariantsCount} Invariants</span>
    </div>

    <div class="tags-list">
      {article.tags.slice(0, 3).map(tag => (
        <span class="tag-pill">#{tag}</span>
      ))}
      {article.tags.length > 3 && (
        <span class="tag-more">+{article.tags.length - 3}</span>
      )}
    </div>
  </div>
</article>

<style>
  .article-card {
    width: 100%;
    min-width: 0;
    overflow: hidden;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: inset 0 1px 0 var(--specular-edge), var(--shadow-card);
    border-radius: 10px;
    padding: 1.3rem 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.22s var(--ease-out-expo), border-color 0.22s var(--ease-out-expo), box-shadow 0.22s var(--ease-out-expo);
  }
  .article-card:hover {
    transform: translateY(-2px);
    border-color: rgba(86, 204, 242, 0.42);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 16px 34px -16px rgba(2, 6, 23, 0.85);
  }
  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    gap: 0.5rem;
  }
  .card-meta-left {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .callno-pill {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-cyan);
    background-color: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .hall-badge {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    max-width: 145px;
    min-width: 0;
    flex-shrink: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hall-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card-title {
    overflow-wrap: anywhere;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.4;
    margin-bottom: 0.6rem;
  }
  .card-title a {
    color: #ffffff;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .card-title a:hover {
    color: var(--accent-cyan);
    text-decoration: none;
  }
  .card-excerpt {
    overflow-wrap: anywhere;
    word-break: break-word;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.78rem;
    gap: 0.5rem;
  }
  .rules-counter {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--accent-gold);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .tags-list {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .tag-pill {
    background-color: var(--bg-elevated);
    color: var(--text-muted);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    font-size: 0.72rem;
  }
  .tag-more {
    color: var(--text-muted);
    font-size: 0.72rem;
  }
</style>
