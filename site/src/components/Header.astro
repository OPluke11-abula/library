---
import Icon from './Icon.astro';

interface Props {
  lang: 'zh' | 'en';
  currentPath?: string;
  alternateUrl?: string;
}

const { lang, currentPath = '', alternateUrl } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const nav = {
  zh: [
    { label: '首頁', href: `${base}/zh/` },
    { label: '典籍目錄', href: `${base}/zh/library/` },
    { label: '學習路徑', href: `${base}/zh/paths/` },
    { label: '關於圖書館', href: `${base}/zh/about/` },
  ],
  en: [
    { label: 'Home', href: `${base}/en/` },
    { label: 'Library Catalog', href: `${base}/en/library/` },
    { label: 'Learning Paths', href: `${base}/en/paths/` },
    { label: 'About Atlas', href: `${base}/en/about/` },
  ]
};

const links = nav[lang];

// Compute default switch URL if not provided
let switchHref = alternateUrl;
if (!switchHref) {
  if (lang === 'zh') {
    switchHref = currentPath.replace(/\/zh(\/|$)/, '/en$1');
    if (!switchHref.includes('/en/')) switchHref = `${base}/en/`;
  } else {
    switchHref = currentPath.replace(/\/en(\/|$)/, '/zh$1');
    if (!switchHref.includes('/zh/')) switchHref = `${base}/zh/`;
  }
}
---

<header class="site-header">
  <div class="container nav-container">
    <a href={`${base}/${lang}/`} class="site-brand">
      <div class="brand-emblem">
        <Icon name="atlas" size={22} strokeWidth={2} />
      </div>
      <div class="brand-text">
        <span class="brand-title">Grand Library</span>
        <span class="brand-subtitle">{lang === 'zh' ? '資工與 AI 知識圖書館' : 'CS & AI Knowledge Atlas'}</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-links">
        {links.map(link => {
          const isActive = currentPath === link.href || (link.href !== `${base}/${lang}/` && currentPath.startsWith(link.href));
          return (
            <li>
              <a href={link.href} class:list={['nav-link', { active: isActive }]}>
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <!-- Language Switch & Mobile Toggle -->
    <div class="nav-actions">
      <a href={switchHref} class="lang-switch" title={lang === 'zh' ? 'Switch to English' : '切換至繁體中文'}>
        <Icon name="globe" size={15} />
        <span class="lang-text">{lang === 'zh' ? 'English' : '繁體中文'}</span>
      </a>

      <button id="mobile-menu-toggle" class="mobile-toggle" aria-label="Toggle navigation menu" aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div id="mobile-menu" class="mobile-menu" hidden>
    <ul class="mobile-nav-links">
      {links.map(link => (
        <li>
          <a href={link.href} class="mobile-nav-link">
            {link.label}
          </a>
        </li>
      ))}
      <li class="mobile-lang-item">
        <a href={switchHref} class="mobile-nav-link lang-mobile">
          <Icon name="globe" size={16} />
          <span>{lang === 'zh' ? 'English' : '繁體中文'}</span>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = mobileMenu.hasAttribute('hidden');
      if (isHidden) {
        mobileMenu.removeAttribute('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
        toggleBtn.classList.add('open');
      } else {
        mobileMenu.setAttribute('hidden', '');
        toggleBtn.setAttribute('aria-expanded', 'false');
        toggleBtn.classList.remove('open');
      }
    });
  }
</script>

<style>
  .site-header {
    background-color: rgba(9, 13, 22, 0.88);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-subtle);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.03), 0 8px 24px -16px rgba(2, 6, 23, 0.85);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  @media (min-width: 640px) {
    .nav-container {
      height: 64px;
    }
  }
  .site-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text-primary);
  }
  .brand-emblem {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: linear-gradient(145deg, var(--bg-elevated) 0%, var(--bg-surface) 100%);
    border: 1px solid var(--border-accent);
    box-shadow: inset 0 1px 0 var(--specular-edge);
    color: var(--accent-cyan);
    transition: border-color 0.2s var(--ease-out-expo), color 0.2s var(--ease-out-expo), box-shadow 0.2s var(--ease-out-expo);
  }
  .site-brand:hover .brand-emblem {
    border-color: var(--accent-gold);
    color: var(--accent-gold);
    box-shadow: inset 0 1px 0 rgba(223, 192, 104, 0.2), 0 0 14px rgba(223, 192, 104, 0.14);
  }
  .brand-text {
    display: flex;
    flex-direction: column;
  }
  .brand-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: #ffffff;
  }
  .brand-subtitle {
    font-size: 0.72rem;
    color: var(--text-muted);
    letter-spacing: 0.015em;
    font-weight: 500;
  }
  .desktop-nav {
    display: none;
  }
  @media (min-width: 768px) {
    .desktop-nav {
      display: block;
    }
  }
  .nav-links {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.4rem 0.25rem;
    position: relative;
    transition: color 0.18s var(--ease-out-expo);
  }
  .nav-link:hover {
    color: #ffffff;
    text-decoration: none;
  }
  .nav-link.active {
    color: var(--accent-cyan);
    font-weight: 600;
  }
  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -6px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-cyan), var(--accent-gold));
    border-radius: 2px;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.36rem 0.8rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: inset 0 1px 0 var(--specular-edge);
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.18s var(--ease-out-expo);
  }
  .lang-switch:hover {
    color: #ffffff;
    border-color: var(--border-accent);
    background-color: var(--bg-elevated);
    text-decoration: none;
  }
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    width: 32px;
    height: 32px;
    background: transparent;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 6px;
    cursor: pointer;
  }
  @media (min-width: 768px) {
    .mobile-toggle {
      display: none;
    }
  }
  .mobile-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: var(--text-secondary);
    transition: all 0.2s ease;
  }
  .mobile-toggle.open .bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .mobile-toggle.open .bar:nth-child(2) {
    opacity: 0;
  }
  .mobile-toggle.open .bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }
  .mobile-menu {
    border-top: 1px solid var(--border-subtle);
    background-color: var(--bg-surface);
    padding: 1rem 1.25rem;
  }
  .mobile-nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .mobile-nav-link {
    display: block;
    font-size: 0.95rem;
    color: var(--text-primary);
    text-decoration: none;
    padding: 0.4rem 0;
  }
  .mobile-lang-item {
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
  }
  .lang-mobile {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-cyan);
  }
</style>
