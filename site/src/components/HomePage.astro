---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from './ArticleCard.astro';
import Icon from './Icon.astro';
import { CURATED_LEARNING_PATHS, KNOWLEDGE_HALLS, loadLibraryArticles } from '../lib/library';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isZh = lang === 'zh';

const { zh, en } = loadLibraryArticles();
const articlesMap = isZh ? zh : en;
const alternateUrl = isZh ? `${base}/en/` : `${base}/zh/`;

const featuredSlugs = ['lib-000', 'lib-001', 'lib-101', 'lib-405', 'lib-501', 'lib-703'];
const featuredArticles = featuredSlugs.map(slug => articlesMap.get(slug)).filter(Boolean);

const showcaseItems = [
  {
    slug: 'lib-001',
    hallTagZh: 'HALL 00 / 總綱導覽',
    hallTagEn: 'HALL 00 / Overview',
    titleZh: 'LIB-001 深度學習第一性原理先修精要',
    titleEn: 'LIB-001 Deep Learning First Principles',
    rationaleZh: '全館核心必修。從微積分高維幾何出發，建立梯度流動直覺，並給出神經元反向傳播的嚴格收斂性證明。',
    rationaleEn: 'Essential first step. Traces high-dimensional vector spaces, builds gradient flow intuition, and derives backward error propagation convergence.',
  },
  {
    slug: 'lib-101',
    hallTagZh: 'HALL 01 / 理論基石',
    hallTagEn: 'HALL 01 / Foundations',
    titleZh: 'LIB-101 高維向量幾何與奇異值分解 (SVD)',
    titleEn: 'LIB-101 High-Dimensional Geometry & SVD',
    rationaleZh: '現代特徵降維與低秩分解的數理本質，直接串接注意力機制運算與 LoRA 權重微調理論。',
    rationaleEn: 'The mathematical core of feature dimensionality reduction, low-rank approximations, and foundational grounding for LoRA adaptation.',
  },
  {
    slug: 'lib-405',
    hallTagZh: 'HALL 04 / 架構機制',
    hallTagEn: 'HALL 04 / Architectures',
    titleZh: 'LIB-405 Transformer 注意力機制之數學演進',
    titleEn: 'LIB-405 Transformer Self-Attention Evolution',
    rationaleZh: '深入剖析 Scaled Dot-Product Attention、Softmax 數值防溢出、張量維度對齊與 FlashAttention GPU 運算瓶頸。',
    rationaleEn: 'Dissects Scaled Dot-Product Attention, Softmax numerical stability bounds, tensor tiling, and FlashAttention IO bottleneck mitigation.',
  },
  {
    slug: 'lib-504',
    hallTagZh: 'HALL 05 / 空間感知',
    hallTagEn: 'HALL 05 / Spatial Sensing',
    titleZh: 'LIB-504 3D 視覺前沿：神經輻射場 (NeRF) 到 3D 高斯潑濺 (3DGS)',
    titleEn: 'LIB-504 3D Gaussian Splatting Theory & Rasterization',
    rationaleZh: '從連續體積渲染積分到可微分 3D 高斯橢球投影，掌握真實即時神經渲染與 GPU Tile-based 光柵化架構。',
    rationaleEn: 'From continuous volume rendering integrals to differentiable 3D Gaussian ellipsoid projections, mastering real-time neural rendering and GPU tile-based rasterization.',
  },
];
---

<BaseLayout
  title={isZh ? '首頁 — 資訊工程與人工智慧雙語知識圖書館' : 'Home — Grand Library: CS & AI Knowledge Atlas'}
  lang={lang}
  alternateUrl={alternateUrl}
>
  <!-- Archival Atlas Cover Hero -->
  <section class="hero-section">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="container hero-container">
      <div class="hero-eyebrow">
        <span>{isZh ? '雙語資訊工程與 AI 研究圖書館' : 'Bilingual CS & AI Research Library'}</span>
      </div>

      <h1 class="hero-title">
        Grand Library
        <span class="hero-subtitle">{isZh ? '資訊工程與人工智慧知識圖書館' : 'CS & AI Knowledge Atlas'}</span>
      </h1>

      <p class="hero-description">
        {isZh
          ? '從直觀心智模型出發，串聯嚴格數學推導、GPU 硬體體系結構與現代 AI 系統實作。幫你搞懂「為什麼這樣設計」，再深入底層細節。'
          : 'Learn from first-principle mental models through formal mathematical derivations, GPU hardware architecture, and production AI systems.'}
      </p>

      <!-- Editorial Corpus Strip -->
      <ul class="atlas-meta-strip" aria-label={isZh ? '館藏規模摘要' : 'Library Scope'}>
        <li><strong>28</strong> {isZh ? '核心典籍' : 'Volumes'}</li>
        <li class="strip-sep" aria-hidden="true">/</li>
        <li><strong>56</strong> {isZh ? '雙語鏡像篇章' : 'Bilingual Editions'}</li>
        <li class="strip-sep" aria-hidden="true">/</li>
        <li><strong>{KNOWLEDGE_HALLS.length}</strong> {isZh ? '專業分館' : 'Knowledge Halls'}</li>
        <li class="strip-sep" aria-hidden="true">/</li>
        <li><strong>{CURATED_LEARNING_PATHS.length}</strong> {isZh ? '學習路線' : 'Guided Tracks'}</li>
      </ul>

      <!-- Primary Learning Actions -->
      <div class="hero-actions">
        <a href={`${base}/${lang}/paths/`} class="btn-primary">
          <Icon name="layers" size={16} />
          <span>{isZh ? '選擇學習路線' : 'Choose a Learning Track'}</span>
        </a>
        <a href={`${base}/${lang}/notes/lib-001/`} class="btn-secondary">
          <Icon name="compass" size={16} />
          <span>{isZh ? '從第一課開始 (LIB-001)' : 'Start First Lesson (LIB-001)'}</span>
        </a>
        <a href={`${base}/${lang}/library/`} class="btn-outline">
          <Icon name="book-open" size={16} />
          <span>{isZh ? '瀏覽全館目錄' : 'Browse Catalog'}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Curated Entry Showcase (Asymmetric Anchor + 3-Col Pillars) -->
  <section class="curated-showcase-section">
    <div class="container">
      <div class="section-header">
        <div class="section-rule" aria-hidden="true"></div>
        <h2 class="section-title">{isZh ? '基石篇目導讀建議' : 'Recommended Starting Volumes'}</h2>
        <p class="section-desc">
          {isZh
            ? '初次造訪可由以下四篇核心基石切入，循序建立理論直覺與系統邊界概念。'
            : 'New to the Atlas? Start with these four foundational volumes to build geometric intuition and systems rigor.'}
        </p>
      </div>

      <div class="showcase-grid">
        {showcaseItems.map((item, idx) => (
          <div class:list={['showcase-card', { 'showcase-card-lead': idx === 0 }]}>
            <div class="showcase-body">
              <div class="showcase-hall">{isZh ? item.hallTagZh : item.hallTagEn}</div>
              <h3 class="showcase-title">
                <a href={`${base}/${lang}/notes/${item.slug}/`}>{isZh ? item.titleZh : item.titleEn}</a>
              </h3>
              <p class="showcase-rationale">
                <strong>{isZh ? '推薦理由：' : 'Why Read:'}</strong> {isZh ? item.rationaleZh : item.rationaleEn}
              </p>
            </div>
            <div class="showcase-footer">
              <a href={`${base}/${lang}/notes/${item.slug}/`} class="showcase-link">
                <span>{isZh ? '開始研讀' : 'Read Lesson'}</span>
                <Icon name="arrow-right" size={14} />
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ten Knowledge Halls (Symmetrical 2-Column Archival Wings) -->
  <section class="halls-section">
    <div class="container">
      <div class="section-header">
        <div class="section-rule" aria-hidden="true"></div>
        <h2 class="section-title">{isZh ? '十大知識分館 (Ten Knowledge Halls)' : 'Ten Specialized Knowledge Halls'}</h2>
        <p class="section-desc">
          {isZh
            ? '依學科內在結構劃分為十個分館，涵蓋數理理論、硬體架構、電腦視覺與智慧代理人。'
            : 'Organized into ten domain wings spanning theory, computer architecture, spatial vision, and AI agents.'}
        </p>
      </div>

      <div class="halls-grid">
        {KNOWLEDGE_HALLS.map(hall => {
          const hallArticles = Array.from(articlesMap.values()).filter(a => a.hall.code === hall.code);
          return (
            <a href={`${base}/${lang}/library/?hall=${hall.code}`} class="hall-card">
              <div class="hall-icon-wrapper">
                <Icon name={hall.iconName} size={20} strokeWidth={1.85} />
              </div>
              <div class="hall-main">
                <div class="hall-card-top">
                  <div class="hall-title-group">
                    <h3 class="hall-name">{isZh ? hall.nameZh : hall.nameEn}</h3>
                    <span class="hall-name-en">{isZh ? hall.nameEn : hall.nameZh}</span>
                  </div>
                  <div class="hall-badge-meta">
                    <span class="hall-code">HALL {hall.code}</span>
                    <span class="hall-count">{hallArticles.length} {isZh ? '篇典籍' : 'Volumes'}</span>
                  </div>
                </div>
                <p class="hall-desc">{isZh ? hall.descriptionZh : hall.descriptionEn}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Featured Articles -->
  <section class="featured-section">
    <div class="container">
      <div class="section-header">
        <div class="section-rule" aria-hidden="true"></div>
        <h2 class="section-title">{isZh ? '精選核心典籍 (Featured Articles)' : 'Featured Core Volumes'}</h2>
        <p class="section-desc">
          {isZh
            ? '從圖書館總綱到高維視覺與智慧代理人，精選代表性典籍一覽。'
            : 'Representative volumes highlighting clear conceptual intuition paired with verifiable technical depth.'}
        </p>
      </div>

      <div class="articles-grid">
        {featuredArticles.map(art => (
          <ArticleCard article={art!} lang={lang} />
        ))}
      </div>

      <div class="featured-all-cta">
        <a href={`${base}/${lang}/library/`} class="btn-outline">
          <span>{isZh ? '查看全部 28 篇典籍' : 'View All 28 Volumes'}</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    overflow: hidden;
    padding: 3.5rem 0 3rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .hero-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background-image:
      radial-gradient(ellipse 68% 58% at 50% -12%, rgba(86, 204, 242, 0.13), transparent 70%),
      radial-gradient(ellipse 46% 42% at 50% 108%, rgba(223, 192, 104, 0.07), transparent 72%),
      linear-gradient(to right, rgba(168, 182, 202, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(168, 182, 202, 0.045) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 44px 44px, 44px 44px;
    mask-image: radial-gradient(ellipse 82% 80% at 50% 42%, #000 18%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 82% 80% at 50% 42%, #000 18%, transparent 80%);
  }
  .hero-container {
    position: relative;
    z-index: 1;
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.025em;
    color: var(--accent-gold);
    margin-bottom: 0.85rem;
  }
  .hero-eyebrow::before,
  .hero-eyebrow::after {
    content: '';
    width: 22px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(223, 192, 104, 0.65));
  }
  .hero-eyebrow::after {
    background: linear-gradient(90deg, rgba(223, 192, 104, 0.65), transparent);
  }
  .hero-title {
    font-size: 2.85rem;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin-bottom: 0.95rem;
    color: #ffffff;
    border-bottom: none;
    padding-bottom: 0;
    margin-top: 0;
  }
  .hero-subtitle {
    display: block;
    font-size: 1.32rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    letter-spacing: 0.015em;
  }
  .hero-description {
    font-size: 1.02rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.45rem;
    max-width: 65ch;
    margin-left: auto;
    margin-right: auto;
  }
  .atlas-meta-strip {
    list-style: none;
    padding: 0.55rem 1.15rem;
    margin: 0 auto 1.7rem;
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.84rem;
    color: var(--text-muted);
    background-color: rgba(15, 22, 36, 0.72);
    border: 1px solid var(--border-subtle);
    box-shadow: inset 0 1px 0 var(--specular-edge);
    border-radius: 9999px;
  }
  .atlas-meta-strip li {
    margin: 0;
    line-height: 1.4;
  }
  .atlas-meta-strip strong {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: #ffffff;
  }
  .strip-sep {
    color: var(--border-accent);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }
  .btn-primary, .btn-secondary, .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    border-radius: 7px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s var(--ease-out-expo), background-color 0.2s var(--ease-out-expo), border-color 0.2s var(--ease-out-expo), color 0.2s var(--ease-out-expo);
  }
  .btn-primary {
    background-color: var(--accent-cyan);
    color: #090d16;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 8px 20px -8px rgba(86, 204, 242, 0.45);
  }
  .btn-primary:hover {
    background-color: #8be0fa;
    color: #090d16;
    transform: translateY(-1px);
    text-decoration: none;
  }
  .btn-secondary {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-accent);
    box-shadow: inset 0 1px 0 var(--specular-edge);
  }
  .btn-secondary:hover {
    background-color: var(--bg-elevated);
    border-color: var(--accent-cyan);
    color: #ffffff;
    text-decoration: none;
  }
  .btn-outline {
    background-color: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }
  .btn-outline:hover {
    color: #ffffff;
    border-color: var(--border-accent);
    background-color: rgba(255, 255, 255, 0.03);
    text-decoration: none;
  }

  /* Editorial Section Headers */
  .section-header {
    text-align: left;
    max-width: 720px;
    margin: 0 0 2rem;
  }
  .section-rule {
    width: 34px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-gold), var(--accent-cyan));
    border-radius: 2px;
    margin-bottom: 0.7rem;
  }
  .section-title {
    font-size: 1.78rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-top: 0;
    margin-bottom: 0.5rem;
    border-bottom: none;
    padding-bottom: 0;
  }
  .section-desc {
    font-size: 0.94rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 0;
  }

  /* Showcase (Asymmetric Anchor Lead + 3-Col Row) */
  .curated-showcase-section {
    padding: 3.4rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .showcase-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .showcase-card {
    min-width: 0;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: inset 0 1px 0 var(--specular-edge), var(--shadow-card);
    border-radius: 10px;
    padding: 1.4rem 1.45rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.22s var(--ease-out-expo), transform 0.22s var(--ease-out-expo), box-shadow 0.22s var(--ease-out-expo);
  }
  .showcase-card:hover {
    border-color: rgba(86, 204, 242, 0.38);
    transform: translateY(-2px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.09), 0 16px 34px -16px rgba(2, 6, 23, 0.85);
  }
  .showcase-card-lead {
    border-left: 3px solid var(--accent-gold);
    background: linear-gradient(110deg, rgba(223, 192, 104, 0.06) 0%, var(--bg-surface) 42%);
  }
  @media (min-width: 768px) {
    .showcase-card-lead {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      gap: 2rem;
      padding: 1.65rem 1.85rem;
    }
    .showcase-card-lead .showcase-body {
      flex: 1 1 auto;
    }
    .showcase-card-lead .showcase-rationale {
      margin-bottom: 0;
      max-width: 72ch;
    }
    .showcase-card-lead .showcase-footer {
      flex-shrink: 0;
    }
  }
  .showcase-hall {
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--accent-gold);
    margin-bottom: 0.45rem;
  }
  .showcase-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    margin-bottom: 0.6rem;
    line-height: 1.38;
  }
  .showcase-card-lead .showcase-title {
    font-size: 1.34rem;
  }
  .showcase-title a {
    color: #ffffff;
    text-decoration: none;
  }
  .showcase-title a:hover {
    color: var(--accent-cyan);
  }
  .showcase-rationale {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.1rem;
  }
  .showcase-rationale strong {
    color: #e6edf6;
  }
  .showcase-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--accent-cyan);
    text-decoration: none;
  }
  .showcase-card-lead .showcase-link {
    padding: 0.55rem 1rem;
    background-color: rgba(86, 204, 242, 0.1);
    border: 1px solid rgba(86, 204, 242, 0.28);
    border-radius: 6px;
  }
  .showcase-link:hover {
    color: #8be0fa;
    text-decoration: none;
  }

  /* Ten Knowledge Halls (Symmetrical 2-Column Archival Wings) */
  .halls-section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .halls-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .halls-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.1rem 1.25rem;
    }
  }
  .hall-card {
    min-width: 0;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: inset 0 1px 0 var(--specular-edge);
    border-radius: 10px;
    padding: 1.15rem 1.3rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    text-decoration: none;
    transition: border-color 0.2s var(--ease-out-expo), background-color 0.2s var(--ease-out-expo), transform 0.2s var(--ease-out-expo);
  }
  .hall-card:hover {
    border-color: rgba(86, 204, 242, 0.45);
    background-color: #131c2e;
    transform: translateY(-1px);
    text-decoration: none;
  }
  .hall-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border-radius: 8px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-accent);
    color: var(--accent-cyan);
    margin-top: 0.1rem;
    transition: color 0.2s var(--ease-out-expo), border-color 0.2s var(--ease-out-expo);
  }
  .hall-card:hover .hall-icon-wrapper {
    color: var(--accent-gold);
    border-color: rgba(223, 192, 104, 0.45);
  }
  .hall-main {
    min-width: 0;
    flex: 1;
  }
  .hall-card-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.65rem;
    margin-bottom: 0.4rem;
  }
  .hall-title-group {
    min-width: 0;
  }
  .hall-badge-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .hall-code {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-gold);
    background-color: rgba(223, 192, 104, 0.1);
    border: 1px solid rgba(223, 192, 104, 0.22);
    padding: 0.1rem 0.42rem;
    border-radius: 4px;
  }
  .hall-count {
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }
  .hall-name {
    font-family: var(--font-serif);
    font-size: 1.05rem;
