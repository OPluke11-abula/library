---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from './ArticleCard.astro';
import Icon from './Icon.astro';
import { CURATED_LEARNING_PATHS, KNOWLEDGE_HALLS, loadLibraryArticles } from '../lib/library';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isZh = lang === 'zh';

const { zh, en } = loadLibraryArticles();
const articlesMap = isZh ? zh : en;
const alternateUrl = isZh ? `${base}/en/` : `${base}/zh/`;

const featuredSlugs = ['lib-000', 'lib-001', 'lib-101', 'lib-405', 'lib-501', 'lib-703'];
const featuredArticles = featuredSlugs.map(slug => articlesMap.get(slug)).filter(Boolean);

const showcaseItems = [
  {
    slug: 'lib-001',
    hallTagZh: 'HALL 00 • 總綱導覽',
    hallTagEn: 'HALL 00 • OVERVIEW',
    titleZh: 'LIB-001 深度學習第一性原理先修精要',
    titleEn: 'LIB-001 Deep Learning First Principles',
    rationaleZh: '全館核心必修。從微積分高維幾何出發，建立梯度流動直覺，並給出神經元反向傳播的嚴格收斂性證明。',
    rationaleEn: 'Essential first step. Traces high-dimensional vector spaces, builds gradient flow intuition, and derives backward error propagation convergence.',
  },
  {
    slug: 'lib-101',
    hallTagZh: 'HALL 01 • 理論基石',
    hallTagEn: 'HALL 01 • FOUNDATIONS',
    titleZh: 'LIB-101 高維向量幾何與奇異值分解 (SVD)',
    titleEn: 'LIB-101 High-Dimensional Geometry & SVD',
    rationaleZh: '現代特徵降維與低秩分解的數理本質，直接串接注意力機制運算與 LoRA 權重微調理論。',
    rationaleEn: 'The mathematical core of feature dimensionality reduction, low-rank approximations, and foundational grounding for LoRA adaptation.',
  },
  {
    slug: 'lib-405',
    hallTagZh: 'HALL 04 • 架構機制',
    hallTagEn: 'HALL 04 • ARCHITECTURES',
    titleZh: 'LIB-405 Transformer 注意力機制之數學演進',
    titleEn: 'LIB-405 Transformer Self-Attention Evolution',
    rationaleZh: '深入剖析 Scaled Dot-Product Attention、Softmax 數值防溢出、張量維度對齊與 FlashAttention GPU 運算瓶頸。',
    rationaleEn: 'Dissects Scaled Dot-Product Attention, Softmax numerical stability bounds, tensor tiling, and FlashAttention IO bottleneck mitigation.',
  },
  {
    slug: 'lib-504',
    hallTagZh: 'HALL 05 • 空間感知',
    hallTagEn: 'HALL 05 • SPATIAL SENSING',
    titleZh: 'LIB-504 3D 視覺前沿：神經輻射場 (NeRF) 到 3D 高斯潑濺 (3DGS)',
    titleEn: 'LIB-504 3D Gaussian Splatting Theory & Rasterization',
    rationaleZh: '從連續體積渲染積分到可微分 3D 高斯橢球投影，掌握真實即時神經渲染與 GPU Tile-based 光柵化架構。',
    rationaleEn: 'From continuous volume rendering integrals to differentiable 3D Gaussian ellipsoid projections, mastering real-time neural rendering and GPU tile-based rasterization.',
  },
];
---

<BaseLayout
  title={isZh ? '首頁 — 資訊工程與人工智慧雙語知識圖書館' : 'Home — Grand Library: CS & AI Knowledge Atlas'}
  lang={lang}
  alternateUrl={alternateUrl}
>
  <!-- Reader-First Hero -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-eyebrow">
        <span>{isZh ? '雙語資訊工程與 AI 研究圖書館' : 'Bilingual CS & AI Research Library'}</span>
      </div>

      <h1 class="hero-title">
        Grand Library<br />
        <span class="hero-subtitle">{isZh ? '資訊工程與人工智慧知識圖書館' : 'CS & AI Knowledge Atlas'}</span>
      </h1>

      <p class="hero-description">
        {isZh
          ? '從直觀心智模型出發，串聯嚴格數學推導、GPU 硬體體系結構與現代 AI 系統實作。幫你搞懂「為什麼這樣設計」，再深入底層細節。'
          : 'Learn from first-principle mental models through formal mathematical derivations, GPU hardware architecture, and production AI systems.'}
      </p>

      <!-- Editorial Corpus Strip (replaces KPI dashboard cards) -->
      <ul class="atlas-meta-strip" aria-label={isZh ? '館藏規模摘要' : 'Library Scope'}>
        <li><strong>28</strong> {isZh ? '核心典籍' : 'Volumes'}</li>
        <li class="strip-sep" aria-hidden="true">·</li>
        <li><strong>56</strong> {isZh ? '雙語鏡像篇章' : 'Bilingual Editions'}</li>
        <li class="strip-sep" aria-hidden="true">·</li>
        <li><strong>{KNOWLEDGE_HALLS.length}</strong> {isZh ? '專業分館' : 'Knowledge Halls'}</li>
        <li class="strip-sep" aria-hidden="true">·</li>
        <li><strong>{CURATED_LEARNING_PATHS.length}</strong> {isZh ? '學習路線' : 'Guided Tracks'}</li>
      </ul>

      <!-- Primary Learning Actions -->
      <div class="hero-actions">
        <a href={`${base}/${lang}/paths/`} class="btn-primary">
          <Icon name="layers" size={16} />
          <span>{isZh ? '選擇學習路線' : 'Choose a Learning Track'}</span>
        </a>
        <a href={`${base}/${lang}/notes/lib-001/`} class="btn-secondary">
          <Icon name="compass" size={16} />
          <span>{isZh ? '從第一課開始 (LIB-001)' : 'Start First Lesson (LIB-001)'}</span>
        </a>
        <a href={`${base}/${lang}/library/`} class="btn-outline">
          <Icon name="book-open" size={16} />
          <span>{isZh ? '瀏覽全館目錄' : 'Browse Catalog'}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Curated Entry Showcase -->
  <section class="curated-showcase-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">GUIDED ENTRY</span>
        <h2 class="section-title">{isZh ? '基石篇目導讀建議' : 'Recommended Starting Volumes'}</h2>
        <p class="section-desc">
          {isZh
            ? '初次造訪可由以下四篇核心基石切入，循序建立理論直覺與系統邊界概念。'
            : 'New to the Atlas? Start with these four foundational volumes to build geometric intuition and systems rigor.'}
        </p>
      </div>

      <div class="showcase-grid">
        {showcaseItems.map(item => (
          <div class="showcase-card">
            <div>
              <div class="showcase-hall">{isZh ? item.hallTagZh : item.hallTagEn}</div>
              <h3 class="showcase-title">
                <a href={`${base}/${lang}/notes/${item.slug}/`}>{isZh ? item.titleZh : item.titleEn}</a>
              </h3>
              <p class="showcase-rationale">
                <strong>{isZh ? '推薦理由：' : 'Why Read:'}</strong> {isZh ? item.rationaleZh : item.rationaleEn}
              </p>
            </div>
            <a href={`${base}/${lang}/notes/${item.slug}/`} class="showcase-link">
              <span>{isZh ? '開始研讀' : 'Read Lesson'}</span>
              <Icon name="arrow-right" size={14} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ten Knowledge Halls -->
  <section class="halls-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">TAXONOMY</span>
        <h2 class="section-title">{isZh ? '十大知識分館 (Ten Knowledge Halls)' : 'Ten Specialized Knowledge Halls'}</h2>
        <p class="section-desc">
          {isZh
            ? '依學科內在結構劃分為十個分館，涵蓋數理理論、硬體架構、電腦視覺與智慧代理人。'
            : 'Organized into ten domain wings spanning theory, computer architecture, spatial vision, and AI agents.'}
        </p>
      </div>

      <div class="halls-grid">
        {KNOWLEDGE_HALLS.map(hall => {
          const hallArticles = Array.from(articlesMap.values()).filter(a => a.hall.code === hall.code);
          return (
            <a href={`${base}/${lang}/library/?hall=${hall.code}`} class="hall-card">
              <div class="hall-card-top">
                <div class="hall-icon-wrapper">
                  <Icon name={hall.iconName} size={20} strokeWidth={2} />
                </div>
                <div class="hall-badge-meta">
                  <span class="hall-code">HALL {hall.code}</span>
                  <span class="hall-count">{hallArticles.length} {isZh ? '篇典籍' : 'Volumes'}</span>
                </div>
              </div>
              <div class="hall-meta">
                <h3 class="hall-name">{isZh ? hall.nameZh : hall.nameEn}</h3>
                <span class="hall-name-en">{isZh ? hall.nameEn : hall.nameZh}</span>
                <p class="hall-desc">{isZh ? hall.descriptionZh : hall.descriptionEn}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Featured Articles -->
  <section class="featured-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">CURATED REPOSITORY</span>
        <h2 class="section-title">{isZh ? '精選核心典籍 (Featured Articles)' : 'Featured Core Volumes'}</h2>
        <p class="section-desc">
          {isZh
            ? '從圖書館總綱到高維視覺與智慧代理人，精選代表性典籍一覽。'
            : 'Representative volumes highlighting clear conceptual intuition paired with verifiable technical depth.'}
        </p>
      </div>

      <div class="articles-grid">
        {featuredArticles.map(art => (
          <ArticleCard article={art!} lang={lang} />
        ))}
      </div>

      <div class="featured-all-cta">
        <a href={`${base}/${lang}/library/`} class="btn-outline">
          <span>{isZh ? '查看全部 28 篇典籍' : 'View All 28 Volumes'}</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding: 3.25rem 0 2.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .hero-container {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-cyan);
    margin-bottom: 0.75rem;
  }
  .hero-title {
    font-size: 2.7rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 0.9rem;
    color: #ffffff;
    border-bottom: none;
    padding-bottom: 0;
  }
  .hero-subtitle {
    display: block;
    font-size: 1.32rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-top: 0.45rem;
    font-family: var(--font-sans);
    letter-spacing: 0.02em;
  }
  .hero-description {
    font-size: 1.02rem;
    color: var(--text-secondary);
    line-height: 1.68;
    margin-bottom: 1.35rem;
    max-width: 680px;
    margin-left: auto;
    margin-right: auto;
  }
  .atlas-meta-strip {
    list-style: none;
    padding: 0.5rem 1rem;
    margin: 0 auto 1.65rem;
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.84rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }
  .atlas-meta-strip li {
    margin: 0;
    line-height: 1.4;
  }
  .atlas-meta-strip strong {
    font-family: var(--font-mono);
    color: #ffffff;
  }
  .strip-sep {
    color: var(--border-accent);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }
  .btn-primary, .btn-secondary, .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.62rem 1.2rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .btn-primary {
    background-color: var(--accent-cyan);
    color: #0b0f19;
  }
  .btn-primary:hover {
    background-color: #7dd3fc;
    color: #0b0f19;
    text-decoration: none;
  }
  .btn-secondary {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-accent);
  }
  .btn-secondary:hover {
    background-color: var(--bg-elevated);
    border-color: var(--accent-cyan);
    color: #ffffff;
    text-decoration: none;
  }
  .btn-outline {
    background-color: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }
  .btn-outline:hover {
    color: #ffffff;
    border-color: var(--text-secondary);
    text-decoration: none;
  }

  /* Showcase */
  .curated-showcase-section {
    padding: 3.25rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .section-header {
    text-align: center;
    max-width: 660px;
    margin: 0 auto 2.25rem;
  }
  .section-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-cyan);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.4rem;
  }
  .section-title {
    font-size: 1.8rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.6rem;
    border-bottom: none;
    padding-bottom: 0;
  }
  .section-desc {
    font-size: 0.94rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }
  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.35rem;
  }
  @media (min-width: 768px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .showcase-card {
    min-width: 0;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .showcase-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }
  .showcase-hall {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.05em;
    margin-bottom: 0.45rem;
  }
  .showcase-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    margin-bottom: 0.65rem;
    line-height: 1.4;
  }
  .showcase-title a {
    color: #ffffff;
    text-decoration: none;
  }
  .showcase-title a:hover {
    color: var(--accent-cyan);
  }
  .showcase-rationale {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.58;
    margin-bottom: 1.1rem;
  }
  .showcase-rationale strong {
    color: #e2e8f0;
  }
  .showcase-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-cyan);
    text-decoration: none;
  }
  .showcase-link:hover {
    color: #7dd3fc;
  }

  /* Halls */
  .halls-section {
    padding: 3.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .halls-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .halls-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .halls-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .hall-card {
    min-width: 0;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.25rem 1.35rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .hall-card:hover {
    border-color: var(--accent-cyan);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .hall-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.7rem;
  }
  .hall-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--accent-cyan);
  }
  .hall-badge-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hall-code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-gold);
    background-color: rgba(212, 175, 55, 0.1);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }
  .hall-count {
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .hall-name {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.2rem;
  }
  .hall-name-en {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.55rem;
  }
  .hall-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0;
  }

  /* Featured */
  .featured-section {
    padding: 3.5rem 0 4.5rem;
  }
  .articles-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.35rem;
    margin-bottom: 2.25rem;
  }
  @media (min-width: 768px) {
    .articles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .featured-all-cta {
    text-align: center;
  }

  @media (max-width: 639px) {
    .hero-section {
      padding: 1.5rem 0 1.75rem;
    }
    .hero-eyebrow {
      font-size: 0.7rem;
      margin-bottom: 0.45rem;
    }
    .hero-title {
      font-size: 2rem;
      margin-bottom: 0.6rem;
    }
    .hero-subtitle {
      font-size: 1.02rem;
      margin-top: 0.3rem;
    }
    .hero-description {
      font-size: 0.92rem;
      line-height: 1.55;
      margin-bottom: 1rem;
    }
    .atlas-meta-strip {
      font-size: 0.78rem;
      padding: 0.45rem 0.65rem;
      margin-bottom: 1.15rem;
      gap: 0.4rem;
    }
    .hero-actions {
      gap: 0.55rem;
    }
    .btn-primary, .btn-secondary, .btn-outline {
      width: 100%;
      justify-content: center;
      padding: 0.55rem 1rem;
    }
    .curated-showcase-section, .halls-section, .featured-section {
      padding: 2.25rem 0;
    }
    .section-header {
      margin-bottom: 1.35rem;
    }
  }
</style>
