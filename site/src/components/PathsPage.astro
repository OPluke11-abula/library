---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import { CURATED_LEARNING_PATHS, loadLibraryArticles } from '../lib/library';

interface Props {
  lang: 'zh' | 'en';
}

const { lang } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isZh = lang === 'zh';

const { zh, en } = loadLibraryArticles();
const articlesMap = isZh ? zh : en;
const alternateUrl = isZh ? `${base}/en/paths/` : `${base}/zh/paths/`;

const trackMeta: Record<string, { shortZh: string; shortEn: string; icon: string; span: string }> = {
  'deep-learning-foundations': {
    shortZh: 'Deep Learning · 深度學習基礎',
    shortEn: 'Deep Learning',
    icon: 'network',
    span: 'LIB-000 → LIB-602',
  },
  'spatial-ai-and-3d-vision': {
    shortZh: 'Computer Vision & 3D · 視覺與空間感知',
    shortEn: 'Computer Vision & 3D',
    icon: 'camera',
    span: 'LIB-000 → LIB-506',
  },
  'intelligent-agents-and-systems': {
    shortZh: 'AI Agents · 智慧代理人與決策',
    shortEn: 'AI Agents',
    icon: 'bot',
    span: 'LIB-000 → LIB-704',
  },
};
---

<BaseLayout
  title={isZh ? '學習路徑 — 系統化知識方向指引' : 'Learning Paths — Guided Study Tracks'}
  lang={lang}
  alternateUrl={alternateUrl}
>
  <div class="paths-page">
    <div class="container">
      <!-- Concise Action-First Header -->
      <header class="paths-header">
        <div class="paths-rule" aria-hidden="true"></div>
        <h1 class="paths-title">{isZh ? '選擇你的學習方向' : 'Choose a Learning Track'}</h1>
        <p class="paths-lead">
          {isZh
            ? '依照學習目標挑選一個領域路線。每條路線都依循知識先後順序排列，從整體導覽出發，帶你逐步理解核心觀念與系統實作。'
            : 'Pick a curated domain track based on what you want to build and understand. Every module follows its conceptual prerequisite order cleanly from overview to depth.'}
        </p>
      </header>

      <!-- First-Screen Track Chooser (3 Actionable Directions) -->
      <section class="track-chooser-section" aria-label={isZh ? '三大學習方向' : 'Three Learning Directions'}>
        <div class="track-selector-grid">
          {CURATED_LEARNING_PATHS.map((path) => {
            const meta = trackMeta[path.id] || { shortZh: path.badge, shortEn: path.badge, icon: 'compass', span: 'LIB-000 →' };
            const secondStep = path.steps[1];
            return (
              <article class="track-chooser-card" data-track={path.id}>
                <div class="track-chooser-top">
                  <div class="track-icon-box">
                    <Icon name={meta.icon} size={18} strokeWidth={2} />
                  </div>
                  <span class="track-module-count">
                    {path.steps.length} {isZh ? '個模組' : 'Modules'}
                  </span>
                </div>

                <h2 class="track-chooser-heading">{isZh ? meta.shortZh : meta.shortEn}</h2>
                <h3 class="track-chooser-sub">{isZh ? path.titleZh : path.titleEn}</h3>
                <p class="track-chooser-desc">{isZh ? path.descriptionZh : path.descriptionEn}</p>

                <div class="track-chooser-meta">
                  <span class="track-span">{meta.span}</span>
                  {secondStep && (
                    <span class="track-entry-note">
                      {isZh
                        ? `經 LIB-000 導覽後進入 ${secondStep.callNumber}`
                        : `Starts at LIB-000 overview → ${secondStep.callNumber}`}
                    </span>
                  )}
                </div>

                <div class="track-chooser-actions">
                  <a href={`#${path.id}`} class="btn-track-primary">
                    <span>{isZh ? '查看學習路線' : 'View Learning Path'}</span>
                    <Icon name="arrow-right" size={14} />
                  </a>
                  <a href={`${base}/${lang}/notes/${path.steps[0].slug}/`} class="btn-track-secondary">
                    {isZh ? '直接開始第 1 步' : 'Start Step 1'}
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </section>

      <!-- Detailed Track Sequences (Preserves all 3 Paths, 23 Steps, 20 Direct Edges) -->
      <section class="paths-list-section" aria-label={isZh ? '學習路線詳情' : 'Detailed Learning Sequences'}>
        {CURATED_LEARNING_PATHS.map((path, pIdx) => {
          const meta = trackMeta[path.id] || { shortZh: path.badge, shortEn: path.badge, icon: 'compass', span: '' };
          const outcomes = isZh ? path.learningOutcomesZh : path.learningOutcomesEn;
          return (
            <div class="path-card" id={path.id} data-track={path.id}>
              <div class="path-header">
                <div class="path-meta-row">
                  <span class="path-index">{isZh ? `路線 ${pIdx + 1}` : `TRACK ${pIdx + 1}`}</span>
                  <span class="path-badge">{isZh ? meta.shortZh : meta.shortEn}</span>
                  <span class="path-length-badge">{path.steps.length} {isZh ? '個研讀模組' : 'Study Modules'}</span>
                </div>

                <h2 class="path-title">{isZh ? path.titleZh : path.titleEn}</h2>
                <p class="path-desc">{isZh ? path.descriptionZh : path.descriptionEn}</p>

                <!-- 1. What Will I Learn? -->
                <div class="path-outcomes-box">
                  <h3 class="outcomes-heading">{isZh ? '這條路線將帶你掌握' : 'What You Will Learn'}</h3>
                  <ul class="dossier-list">
                    {outcomes.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>

                <!-- Accessible Secondary Context (Audience & Starting Overview Accuracy) -->
                <details class="path-context-drawer">
                  <summary class="path-context-summary">
                    <span>
                      {isZh
                        ? `適用對象與起點說明（由 ${path.startingVolume} 圖書館總覽出發）`
                        : `Who this is for & how ${path.startingVolume} overview fits in`}
                    </span>
                    <Icon name="chevron-down" size={14} class="path-context-arrow" />
                  </summary>
                  <div class="path-context-body">
                    <p class="context-item">
                      <strong>{isZh ? '適用讀者：' : 'Audience:'}</strong> {isZh ? path.targetAudienceZh : path.targetAudienceEn}
                    </p>
                    <p class="context-item">
                      <strong>{isZh ? '起點說明：' : 'Entry Point:'}</strong>{' '}
                      {isZh
                        ? `${path.startingVolume} 為圖書館總覽與導航系統（非數學課），用於建立分館分類、證據標記與路線座標；第一性原理與數理推導從 ${path.steps[1]?.callNumber || 'LIB-001'} 展開。`
                        : `${path.startingVolume} serves as the Library Index & Navigator overview (not a math lesson), orienting you across wings and reading conventions before ${path.steps[1]?.callNumber || 'LIB-001'}.`}
                    </p>
                  </div>
                </details>
              </div>

              <!-- Sequential Teaching Timeline -->
              <div class="steps-timeline">
                {path.steps.map((step, sIdx) => {
                  const article = articlesMap.get(step.slug);
                  const articleUrl = `${base}/${lang}/notes/${step.slug}/`;
                  const stepTitle = article ? article.title : (isZh ? step.titleZh : step.titleEn);
                  const nextReason = isZh ? step.whyNextZh : step.whyNextEn;
                  return (
                    <div class="timeline-step">
                      <div class="step-marker">
                        <span class="step-num">{String(sIdx + 1).padStart(2, '0')}</span>
                        {sIdx < path.steps.length - 1 && <span class="step-line"></span>}
                      </div>

                      <div class="step-content">
                        {nextReason && (
                          <div class="step-transition-note">
                            <span class="transition-label">{isZh ? '為何接著讀這篇：' : 'Why this follows:'}</span>
                            <span>{nextReason}</span>
                          </div>
                        )}

                        <div class="step-header">
                          <div class="step-header-left">
                            <span class="step-callno">{step.callNumber}</span>
                            {article && (
                              <span class="step-hall">
                                <Icon name={article.hall.iconName} size={13} />
                                <span>{isZh ? article.hall.nameZh : article.hall.nameEn}</span>
                              </span>
                            )}
                          </div>
                        </div>

                        <h3 class="step-title">
                          <a href={articleUrl}>{stepTitle}</a>
                        </h3>

                        <div class="step-pedagogy-grid">
                          <div class="pedagogy-row">
                            <span class="pedagogy-tag">{isZh ? '學習重點' : 'Key Concepts'}</span>
                            <p>{isZh ? step.focusZh : step.focusEn}</p>
                          </div>
                          <div class="pedagogy-row">
                            <span class="pedagogy-tag">{isZh ? '研讀收穫' : 'Lesson Goal'}</span>
                            <p>{isZh ? step.objectiveZh : step.objectiveEn}</p>
                          </div>
                        </div>

                        <div class="step-action">
                          <a href={articleUrl} class="btn-step-link">
                            <span>{sIdx === 0 ? (isZh ? '從總覽出發' : 'Open Overview') : (isZh ? '開始研讀這篇' : 'Read Lesson')}</span>
                            <Icon name="arrow-right" size={14} />
                          </a>
                        </div>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}
      </section>

      <!-- Secondary Collapsible Global DAG Panorama -->
      <section class="roadmap-diagram-section">
        <details class="roadmap-accordion">
          <summary class="roadmap-summary">
            <div class="roadmap-summary-left">
              <Icon name="layers" size={18} />
              <div class="roadmap-summary-text">
                <h2 class="roadmap-title">{isZh ? '全館知識依賴總覽圖 (Global Knowledge Map)' : 'Global Knowledge Dependency Map'}</h2>
                <span class="roadmap-desc">
                  {isZh
                    ? '點擊展開全館 28 篇典籍之完整先後相依全景圖（參考用）。'
                    : 'Expand to view the complete 28-volume prerequisite topology diagram.'}
                </span>
              </div>
            </div>
            <Icon name="chevron-down" size={18} class="accordion-arrow" />
          </summary>
          <div class="roadmap-card-body">
            <div class="roadmap-img-wrapper">
              <img src={`${base}/assets/00_grand_roadmap.svg`} alt={isZh ? '全館知識依賴總覽圖' : 'Global Knowledge Map'} width="100%" />
            </div>
          </div>
        </details>
      </section>

      <!-- Catalog CTA -->
      <div class="paths-bottom-cta">
        <h3>{isZh ? '想依主題自由檢索全部典籍？' : 'Looking for a specific topic?'}</h3>
        <p>{isZh ? '可至典籍目錄依分館、關鍵字或編號探索全館 28 篇課程。' : 'Browse the full 28-volume catalog by wing, tag, or call number.'}</p>
        <a href={`${base}/${lang}/library/`} class="btn-track-primary" style="margin-top: 0.75rem;">
          <Icon name="book-open" size={16} />
          <span>{isZh ? '前往典籍目錄 (28 篇)' : 'Browse Catalog (28 Volumes)'}</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .paths-page {
    padding: 2.5rem 0 4.5rem;
  }
  .paths-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2.1rem;
  }
  .paths-rule {
    width: 36px;
    height: 2px;
    background: linear-gradient(90deg, var(--accent-gold), var(--accent-cyan));
    border-radius: 2px;
    margin: 0 auto 0.8rem;
  }
  .paths-title {
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-top: 0;
    margin-bottom: 0.7rem;
    border-bottom: none;
    padding-bottom: 0;
  }
  .paths-lead {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.68;
    margin-bottom: 0;
  }

  /* 3-Direction Chooser Grid with Domain-Keyed Top Accents */
  .track-chooser-section {
    margin-bottom: 3rem;
  }
  .track-selector-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 900px) {
    .track-selector-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .track-chooser-card {
    position: relative;
    overflow: hidden;
    min-width: 0;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-top: 2px solid var(--accent-cyan);
    box-shadow: inset 0 1px 0 var(--specular-edge), var(--shadow-card);
    border-radius: 10px;
    padding: 1.35rem 1.35rem 1.3rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.22s var(--ease-out-expo), transform 0.22s var(--ease-out-expo), box-shadow 0.22s var(--ease-out-expo);
  }
  .track-chooser-card[data-track="deep-learning-foundations"] {
    border-top-color: var(--accent-cyan);
    background-image: radial-gradient(circle at 18% 0%, rgba(86, 204, 242, 0.08), transparent 62%);
  }
  .track-chooser-card[data-track="spatial-ai-and-3d-vision"] {
    border-top-color: #34d399;
    background-image: radial-gradient(circle at 18% 0%, rgba(52, 211, 153, 0.08), transparent 62%);
  }
  .track-chooser-card[data-track="intelligent-agents-and-systems"] {
    border-top-color: var(--accent-gold);
    background-image: radial-gradient(circle at 18% 0%, rgba(223, 192, 104, 0.09), transparent 62%);
  }
  .track-chooser-card:hover {
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-2px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 16px 34px -16px rgba(2, 6, 23, 0.88);
  }
  .track-chooser-card[data-track="spatial-ai-and-3d-vision"] .track-icon-box {
    color: #34d399;
    background-color: rgba(52, 211, 153, 0.1);
    border-color: rgba(52, 211, 153, 0.28);
  }
  .track-chooser-card[data-track="spatial-ai-and-3d-vision"] .track-chooser-heading {
    color: #34d399;
  }
  .track-chooser-card[data-track="intelligent-agents-and-systems"] .track-icon-box {
    color: var(--accent-gold);
    background-color: rgba(223, 192, 104, 0.1);
    border-color: rgba(223, 192, 104, 0.28);
  }
  .track-chooser-card[data-track="intelligent-agents-and-systems"] .track-chooser-heading {
    color: var(--accent-gold);
  }
  .track-chooser-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }
  .track-icon-box {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background-color: rgba(86, 204, 242, 0.1);
    border: 1px solid rgba(86, 204, 242, 0.28);
    color: var(--accent-cyan);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .track-module-count {
    font-family: var(--font-sans);
    font-variant-numeric: tabular-nums;
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--accent-gold);
    background-color: rgba(223, 192, 104, 0.1);
    border: 1px solid rgba(223, 192, 104, 0.25);
    padding: 0.16rem 0.55rem;
    border-radius: 9999px;
  }
  .track-chooser-heading {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-cyan);
    margin: 0 0 0.35rem;
    padding: 0;
    border: none;
  }
  .track-chooser-sub {
    font-family: var(--font-serif);
    font-size: 1.18rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.35;
    margin: 0 0 0.55rem;
  }
  .track-chooser-desc {
    font-size: 0.86rem;
    color: var(--text-secondary);
    line-height: 1.56;
    margin-bottom: 0.9rem;
    flex-grow: 1;
  }
  .track-chooser-meta {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    padding-top: 0.75rem;
    margin-bottom: 1rem;
    border-top: 1px solid var(--border-subtle);
  }
  .track-span {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    color: #e6edf6;
    font-weight: 600;
  }
  .track-entry-note {
    font-size: 0.76rem;
    color: var(--text-muted);
  }
  .track-chooser-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
  }
  .btn-track-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.54rem 1.05rem;
    border-radius: 7px;
    background-color: var(--accent-cyan);
    color: #090d16;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35);
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: background-color 0.18s var(--ease-out-expo), transform 0.18s var(--ease-out-expo);
  }
  .btn-track-primary:hover {
    background-color: #8be0fa;
    color: #090d16;
    transform: translateY(-1px);
    text-decoration: none;
  }
  .btn-track-secondary {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.46rem 0.7rem;
    border: 1px solid var(--border-subtle);
    border-radius: 7px;
    transition: border-color 0.18s var(--ease-out-expo), color 0.18s var(--ease-out-expo), background-color 0.18s var(--ease-out-expo);
  }
  .btn-track-secondary:hover {
    color: #ffffff;
    border-color: var(--border-accent);
    background-color: rgba(255, 255, 255, 0.03);
    text-decoration: none;
  }

  /* Track Sequence Cards */
  .paths-list-section {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-bottom: 3.5rem;
  }
  .path-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    box-shadow: inset 0 1px 0 var(--specular-edge), var(--shadow-card);
    border-radius: 12px;
    overflow: hidden;
    scroll-margin-top: 76px;
  }
  .path-header {
    padding: 2rem 2rem 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.025) 0%, transparent 100%);
  }
  .path-meta-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 0.65rem;
    flex-wrap: wrap;
  }
  .path-index {
    font-family: var(--font-sans);
    font-variant-numeric: tabular-nums;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-cyan);
    background-color: rgba(86, 204, 242, 0.1);
    padding: 0.18rem 0.55rem;
    border-radius: 4px;
    border: 1px solid rgba(86, 204, 242, 0.25);
  }
  .path-badge {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-gold);
    background-color: rgba(223, 192, 104, 0.1);
    padding: 0.18rem 0.55rem;
    border-radius: 4px;
    border: 1px solid rgba(223, 192, 104, 0.25);
  }
  .path-length-badge {
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }
  .path-title {
    font-family: var(--font-serif);
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #ffffff;
    margin: 0 0 0.6rem;
    border: none;
    padding: 0;
  }
  .path-desc {
    font-size: 0.94rem;
    color: var(--text-secondary);
    line-height: 1.62;
    margin-bottom: 1.25rem;
    max-width: 820px;
  }
  .path-outcomes-box {
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent-cyan);
    box-shadow: inset 0 1px 0 var(--specular-edge);
    border-radius: 8px;
    padding: 0.95rem 1.15rem;
    margin-bottom: 0.9rem;
  }
  .outcomes-heading {
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.45rem;
  }
  .dossier-list {
    margin: 0;
    padding-left: 1.15rem;
    font-size: 0.85rem;
    color: #cbd5e1;
    line-height: 1.5;
  }
  .dossier-list li {
    margin-bottom: 0.25rem;
  }
  .dossier-list li:last-child {
    margin-bottom: 0;
  }

  .path-context-drawer {
    background-color: rgba(11, 15, 25, 0.35);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
  }
  .path-context-summary {
    padding: 0.6rem 0.9rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    list-style: none;
  }
  .path-context-summary::-webkit-details-marker {
    display: none;
  }
  .path-context-summary:hover {
    color: var(--accent-cyan);
  }
  .path-context-drawer[open] .path-context-arrow {
    transform: rotate(180deg);
  }
  .path-context-body {
    padding: 0.65rem 0.9rem 0.85rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .context-item {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0;
  }
  .context-item strong {
    color: #e2e8f0;
  }

  /* Timeline Steps */
  .steps-timeline {
    padding: 1.75rem 2rem 2rem;
  }
  .timeline-step {
    display: flex;
    gap: 1.4rem;
    position: relative;
  }
  .step-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }
  .step-num {
    width: 34px;
    height: 34px;
