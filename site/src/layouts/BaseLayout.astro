---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang?: 'zh' | 'en';
  alternateUrl?: string;
}

const {
  title,
  description = 'Grand Library — Computer Science & Deep Learning Knowledge Atlas. Rigorous mathematical derivations, GPU architecture alignment, and production-grade engineering.',
  lang = 'zh',
  alternateUrl
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const siteTitle = `${title} | Grand Library`;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-TW' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
    <meta name="description" content={description} />

    <!-- KaTeX Stylesheet (Local offline synced; all UI/article typography uses zero-external-dependency system fonts) -->
    <link rel="stylesheet" href={`${base}/katex/katex.min.css`} />
  </head>
  <body>
    <Header lang={lang} currentPath={currentPath} alternateUrl={alternateUrl} />
    <main class="site-main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .site-main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
</style>
