---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { KNOWLEDGE_HALLS } from '../../lib/library';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="About Atlas — Grand Library" lang="en" alternateUrl={`${base}/zh/about/`}>
  <div class="about-page">
    <div class="container about-container">
      <header class="about-header">
        <span class="about-tag">MISSION & ARCHITECTURE</span>
        <h1 class="about-title">About Grand Library Knowledge Atlas</h1>
        <p class="about-lead">
          A rigorous knowledge atlas for computer science, deep learning, and spatial computing, aligning mathematical derivations, GPU computer architecture, and production invariants.
        </p>
      </header>

      <!-- Vision & Principles -->
      <section class="about-section">
        <div class="section-title-wrap">
          <Icon name="compass" size={20} />
          <h2 class="section-heading">1. Mission & Core Motivation</h2>
        </div>
        <p>
          Curated and maintained by <strong>Luke</strong>. In response to contemporary technical tutorials either oversimplifying models as black-box packages or ignoring modern GPU hardware co-design, Grand Library develops every volume across <strong>four rigorous alignments</strong>:
        </p>
        <div class="quad-grid">
          <div class="quad-card">
            <div class="quad-num">01</div>
            <h3 class="quad-title">Conceptual & Physical Motivation</h3>
            <p>Grounding derivations in geometric intuition and first principles. Understanding physical design motivations before diving into equations.</p>
          </div>
          <div class="quad-card">
            <div class="quad-num">02</div>
            <h3 class="quad-title">Rigorous Mathematical Derivations</h3>
            <p>Complete theorem formulations, closed-form solutions, and convergence bounds citing peer-reviewed literature from CVPR, NeurIPS, ICML, and MLSys.</p>
          </div>
          <div class="quad-card">
            <div class="quad-num">03</div>
            <h3 class="quad-title">Computer Architecture Alignment</h3>
            <p>Hardware-level profiling: cache line hits, NVIDIA CUDA Warp-32 thread scheduling, Tensor Core tiling, and latency bottleneck mitigation.</p>
          </div>
          <div class="quad-card">
            <div class="quad-num">04</div>
            <h3 class="quad-title">Production Engineering Invariants</h3>
            <p>Tensor dimension contracts, numerical overflow boundaries, <code>[SAFETY_BOUND]</code> clamps, and formal system contracts <code>[RULE-###-##]</code>.</p>
          </div>
        </div>
      </section>

      <!-- Architecture and SSOT -->
      <section class="about-section">
        <div class="section-title-wrap">
          <Icon name="file-text" size={20} />
          <h2 class="section-heading">2. Single Source of Truth (SSOT) Architecture</h2>
        </div>
        <p>
          Grand Library adheres strictly to separation of concerns:
        </p>
        <ul class="principles-list">
          <li>
            <strong>Original Markdown Notes are the Single Source of Truth (SSOT)</strong>: Preserved directly in the 10 root hall directories and <code>en/</code> mirrored directories.
          </li>
          <li>
            <strong>Stateless Static Presentation Layer</strong>: Fully encapsulated within the <code>site/</code> directory, powered by Astro + TypeScript for pure static HTML/CSS/JS delivery.
          </li>
          <li>
            <strong>Zero Copying, Zero Modification</strong>: The build pipeline reads Markdown directly, parses Frontmatter in real-time, compiles KaTeX and WikiLinks without duplicating source notes.
          </li>
        </ul>
      </section>

      <!-- Technology Stack -->
      <section class="about-section">
        <div class="section-title-wrap">
          <Icon name="cpu" size={20} />
          <h2 class="section-heading">3. Technology Stack</h2>
        </div>
        <div class="tech-grid">
          <div class="tech-card">
            <div class="tech-icon-box">
              <Icon name="atlas" size={20} />
            </div>
            <div class="tech-info">
              <span class="tech-name">Astro 5.x</span>
              <span class="tech-desc">Modern Static Site Generator (SSG) delivering zero client-side JavaScript by default and lightning performance.</span>
            </div>
          </div>
          <div class="tech-card">
            <div class="tech-icon-box">
              <Icon name="math" size={20} />
            </div>
            <div class="tech-info">
              <span class="tech-name">KaTeX</span>
              <span class="tech-desc">Compile-time static math rendering engine with zero flicker and full offline font bundling.</span>
            </div>
          </div>
          <div class="tech-card">
            <div class="tech-icon-box">
              <Icon name="layers" size={20} />
            </div>
            <div class="tech-info">
              <span class="tech-name">Obsidian WikiLinks Engine</span>
              <span class="tech-desc">Converts double-bracket <code>[[LIB-###]]</code> tokens into type-safe internal site routes.</span>
            </div>
          </div>
          <div class="tech-card">
            <div class="tech-icon-box">
              <Icon name="shield-check" size={20} />
            </div>
            <div class="tech-info">
              <span class="tech-name">11 Invariants Validator</span>
              <span class="tech-desc">Automated validator ensuring DAG completeness, bilingual symmetry, Python AST syntax, and zero broken links.</span>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    padding: 3.5rem 0 5rem;
  }
  .about-container {
    max-width: 860px;
  }
  .about-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }
  .about-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-cyan);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.5rem;
  }
  .about-title {
    font-size: 2.4rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
    border-bottom: none;
    padding-bottom: 0;
  }
  .about-lead {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 0;
  }

  .about-section {
    margin-bottom: 3.5rem;
  }
  .section-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    color: var(--accent-cyan);
  }
  .section-heading {
    font-size: 1.35rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    border: none;
    padding: 0;
  }
  .about-section p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .quad-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 640px) {
    .quad-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .quad-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.4rem;
  }
  .quad-num {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent-cyan);
    margin-bottom: 0.5rem;
  }
  .quad-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.6rem;
  }
  .quad-card p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 0;
  }

  .principles-list {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .principles-list li {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent-cyan);
    border-radius: 0 6px 6px 0;
    padding: 1rem 1.25rem;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }
  .principles-list strong {
    color: #ffffff;
  }

  .tech-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .tech-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .tech-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }
  .tech-icon-box {
    width: 36px;
    height: 36px;
    border-radius: 6px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-cyan);
    flex-shrink: 0;
  }
  .tech-name {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.35rem;
  }
  .tech-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
