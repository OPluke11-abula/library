---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { loadLibraryArticles, getTopologicalArticles, type ArticleData } from '../../../lib/library';

export async function getStaticPaths() {
  const { en } = loadLibraryArticles();
  return Array.from(en.values()).map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

interface Props {
  article: ArticleData;
}

const { article } = Astro.props;
const { en } = loadLibraryArticles();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Get prerequisite and successor articles
const prereqArticles = article.prerequisiteIds.map(id => en.get(id)).filter(Boolean) as ArticleData[];
const successorArticles = article.successorIds.map(id => en.get(id)).filter(Boolean) as ArticleData[];

// Topological sequence for prev/next
const topoArticles = getTopologicalArticles('en');
const currIdx = topoArticles.findIndex(a => a.slug === article.slug);
const prevArticle = currIdx > 0 ? topoArticles[currIdx - 1] : null;
const nextArticle = currIdx >= 0 && currIdx < topoArticles.length - 1 ? topoArticles[currIdx + 1] : null;

const alternateUrl = `${base}/zh/notes/${article.slug}/`;

---

<BaseLayout title={`${article.callNumber} ${article.title}`} lang="en" alternateUrl={alternateUrl}>
  <div class="reader-container">
    <!-- Top Reader Header -->
    <header class="reader-header">
      <div class="container">
        <nav class="reader-breadcrumbs" aria-label="Breadcrumb">
          <a href={`${base}/en/`}>Home</a>
          <span class="bc-sep">/</span>
          <a href={`${base}/en/library/`}>Catalog</a>
          <span class="bc-sep">/</span>
          <a href={`${base}/en/library/?hall=${article.hall.code}`}>{article.hall.code} {article.hall.nameEn}</a>
          <span class="bc-sep">/</span>
          <span class="bc-current">{article.callNumber}</span>
        </nav>

        <div class="header-main-meta">
          <div class="meta-badges">
            <span class="callno-badge">{article.callNumber}</span>
            <span class="hall-badge-head">
              <Icon name={article.hall.iconName} size={14} />
              <span>{article.hall.code} {article.hall.nameEn}</span>
            </span>
          </div>

          <h1 class="reader-title">{article.title}</h1>

          <!-- Executive Reading Guide (Context Brief) -->
          <div class="reader-executive-guide">
            <p class="reader-guide-lead">
              <strong>Study Orientation:</strong> {article.excerpt}
            </p>
            <div class="reader-guide-actions">
              <a href="#article-content" class="btn-start-reading">
                <Icon name="book-open" size={15} />
                <span>Start Reading</span>
              </a>
              {alternateUrl && (
                <a href={alternateUrl} class="btn-mirror-link">
                  <Icon name="globe" size={14} />
                  <span>Traditional Chinese (繁體中文)</span>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Progressive Disclosure: Metadata & Topological Dependencies Drawer -->
    <section class="topo-nav-section">
      <div class="container">
        <details class="metadata-drawer">
          <summary class="metadata-drawer-summary">
            <div class="drawer-summary-left">
              <Icon name="layers" size={16} />
              <span class="drawer-title">DAG Coordinates, Dependencies & Contracts</span>
              <span class="drawer-hint">Click to expand prerequisites, successors, and formal contracts</span>
            </div>
            <Icon name="chevron-down" size={16} class="drawer-arrow" />
          </summary>

          <div class="drawer-content">
            <!-- Metadata & Technical Specification Dossier -->
            <div class="specs-dossier">
              <div class="specs-grid">
                <div class="spec-item">
                  <span class="spec-label">Document Status</span>
                  <div class="spec-value">
                    <span class={`badge-status status-${article.status.toLowerCase().replace(/\s+/g, '-')}`}>
                      {article.status}
                    </span>
                  </div>
                </div>
                <div class="spec-item">
                  <span class="spec-label">Author & Maintenance Date</span>
                  <div class="spec-value author-date">
                    <span>{article.author}</span>
                    <span class="spec-dot">•</span>
                    <span>{article.created}</span>
                  </div>
                </div>
                <div class="spec-item">
                  <span class="spec-label">Target Audience</span>
                  <div class="spec-value">{article.audience.join(', ') || 'CS Students / AI Agents'}</div>
                </div>
                {article.mathFoundations.length > 0 && (
                  <div class="spec-item">
                    <span class="spec-label">Math Foundations</span>
                    <div class="spec-value">{article.mathFoundations.join(', ')}</div>
                  </div>
                )}
                {article.hardwareTarget.length > 0 && (
                  <div class="spec-item">
                    <span class="spec-label">Hardware Target</span>
                    <div class="spec-value">{article.hardwareTarget.join(', ')}</div>
                  </div>
                )}
              </div>
            </div>

            <div class="topo-card">
              <div class="topo-nodes-grid">
                <!-- Prerequisites -->
                <div class="topo-column">
                  <div class="topo-col-header">
                    <Icon name="arrow-left" size={14} />
                    <span class="topo-col-label">Prerequisites</span>
                  </div>
                  {prereqArticles.length === 0 ? (
                    <div class="topo-empty">This volume is a root topological node.</div>
                  ) : (
                    <ul class="topo-list">
                      {prereqArticles.map(pre => (
                        <li>
                          <a href={`${base}/en/notes/${pre.slug}/`} class="topo-link">
                            <span class="topo-code">{pre.callNumber}</span>
                            <span class="topo-text">{pre.title}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                <!-- Successors -->
                <div class="topo-column">
                  <div class="topo-col-header">
                    <span class="topo-col-label">Successors</span>
                    <Icon name="arrow-right" size={14} />
                  </div>
                  {successorArticles.length === 0 ? (
                    <div class="topo-empty">This volume is a frontier topological node.</div>
                  ) : (
                    <ul class="topo-list">
                      {successorArticles.map(suc => (
                        <li>
                          <a href={`${base}/en/notes/${suc.slug}/`} class="topo-link">
                            <span class="topo-code">{suc.callNumber}</span>
                            <span class="topo-text">{suc.title}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </div>

            <!-- Invariants Contract Pills -->
            {article.rules.length > 0 && (
              <div class="drawer-rules-section">
                <div class="drawer-rules-title">
                  <Icon name="shield-check" size={14} />
                  <span>Formally Verified System Invariants</span>
                </div>
                <div class="drawer-rules-grid">
                  {article.rules.map(rule => (
                    <div class="rule-contract-card">
                      <div class="rule-card-top">
                        <span class="rule-pill">{rule.id}</span>
                        {rule.level && <span class="rule-lvl-tag">{rule.level}</span>}
                      </div>
                      <div class="rule-title-text">{rule.title}</div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        </details>
      </div>
    </section>

    <!-- Main Content & Sidebar TOC -->
    <div class="container reader-body-layout">
      <!-- Article Reading Column -->
      <article class="article-body">
        <div id="article-content" class="rendered-markdown" set:html={article.htmlContent} />

        <!-- Sequential prev/next footer -->
        <nav class="reader-pagination" aria-label="Topological Sequence Navigation">
          {prevArticle ? (
            <a href={`${base}/en/notes/${prevArticle.slug}/`} class="page-nav prev">
              <span class="page-dir">
                <Icon name="arrow-left" size={13} />
                <span>Previous Volume</span>
              </span>
              <span class="page-nav-title">{prevArticle.callNumber} {prevArticle.title}</span>
            </a>
          ) : <div class="page-nav-placeholder"></div>}

          {nextArticle ? (
            <a href={`${base}/en/notes/${nextArticle.slug}/`} class="page-nav next">
              <span class="page-dir">
                <span>Next Volume</span>
                <Icon name="arrow-right" size={13} />
              </span>
              <span class="page-nav-title">{nextArticle.callNumber} {nextArticle.title}</span>
            </a>
          ) : <div class="page-nav-placeholder"></div>}
        </nav>
      </article>

      <!-- Sidebar TOC & Invariants -->
      <aside class="reader-sidebar">
        {article.toc.length > 0 && (
          <div class="sidebar-widget toc-widget">
            <div class="widget-header">
              <Icon name="list-tree" size={14} />
              <h3 class="widget-title">Table of Contents</h3>
            </div>
            <nav class="toc-nav" aria-label="Table of Contents">
              <ul>
                {article.toc.map(item => (
                  <li class={`toc-level-${item.level}`}>
                    <a href={`#${item.id}`}>{item.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        )}

        {article.rules.length > 0 && (
          <div class="sidebar-widget rules-widget">
            <div class="widget-header">
              <Icon name="shield-check" size={14} />
              <h3 class="widget-title">Contracts ({article.rules.length})</h3>
            </div>
            <ul class="sidebar-rules-list">
              {article.rules.map(rule => (
                <li>
                  <span class="rule-id-tag">{rule.id}</span>
                  <span class="rule-title-text">{rule.title}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="sidebar-widget tags-widget">
          <div class="widget-header">
            <Icon name="tag" size={14} />
            <h3 class="widget-title">Tags</h3>
          </div>
          <div class="sidebar-tags-cloud">
            {article.tags.map(tag => (
              <span class="sidebar-tag-item">#{tag}</span>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .reader-container {
    padding-bottom: 5rem;
  }
  .reader-header {
    background: radial-gradient(circle at 50% 0%, rgba(30, 41, 59, 0.4) 0%, rgba(11, 15, 25, 0.95) 70%);
    border-bottom: 1px solid var(--border-subtle);
    padding: 2.5rem 0 2rem;
  }
  .reader-breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }
  .reader-breadcrumbs a {
    color: var(--text-secondary);
    text-decoration: none;
  }
  .reader-breadcrumbs a:hover {
    color: var(--accent-cyan);
  }
  .bc-sep {
    color: var(--border-accent);
  }
  .bc-current {
    color: var(--accent-cyan);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .meta-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .callno-badge {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-cyan);
    background-color: rgba(56, 189, 248, 0.12);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }
  .hall-badge-head {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-secondary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
  }
  .invariants-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--accent-gold);
    background-color: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.25);
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .reader-title {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.25;
    color: #ffffff;
    margin-bottom: 1.5rem;
    border-bottom: none;
    padding-bottom: 0;
  }

  /* Executive Brief */
  .executive-brief {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.5rem;
  }
  .brief-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.85rem;
  }
  @media (min-width: 640px) {
    .brief-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .brief-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .brief-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .brief-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .brief-value {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: #e2e8f0;
    font-weight: 500;
  }
  .brief-meta-author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    padding-top: 0.85rem;
    margin-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
  }
  .meta-dot {
    color: var(--border-accent);
  }

  /* Bilingual Switch Bar */
  .bilingual-switch-bar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    background-color: rgba(56, 189, 248, 0.05);
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: 6px;
  }
  @media (min-width: 640px) {
    .bilingual-switch-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .bilingual-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
  }
  .bilingual-notice {
    font-weight: 500;
  }
  .bilingual-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--accent-cyan);
    text-decoration: none;
    padding: 0.3rem 0.75rem;
    border-radius: 4px;
    background-color: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.3);
    white-space: nowrap;
    transition: all 0.15s ease;
  }
  .bilingual-btn:hover {
    background-color: rgba(56, 189, 248, 0.2);
    color: #ffffff;
    text-decoration: none;
  }

  /* Progressive Disclosure Drawer */
  .topo-nav-section {
    padding: 1.25rem 0 2rem;
  }
  .metadata-drawer {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    overflow: hidden;
  }
  .metadata-drawer-summary {
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }
  .metadata-drawer-summary::-webkit-details-marker {
    display: none;
  }
  .drawer-summary-left {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--accent-cyan);
    flex-wrap: wrap;
  }
  .drawer-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: #ffffff;
  }
  .drawer-hint {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .drawer-arrow {
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }
  .metadata-drawer[open] .drawer-arrow {
    transform: rotate(180deg);
  }
  .drawer-content {
    padding: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    background-color: rgba(11, 15, 25, 0.4);
  }
  .topo-nodes-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .topo-nodes-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .topo-column {
    min-width: 0;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 1rem;
  }
  .topo-col-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.75rem;
    color: var(--accent-cyan);
  }
  .topo-col-label {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
  }
  .topo-empty {
    font-size: 0.82rem;
    color: var(--text-muted);
    font-style: italic;
    padding: 0.5rem 0;
  }
  .topo-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .topo-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 100%;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.35rem 0.5rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    transition: all 0.15s ease;
  }
  .topo-link:hover {
    border-color: var(--accent-cyan);
    color: #ffffff;
  }
  .topo-code {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }
  .topo-text {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Drawer Rules */
  .drawer-rules-section {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }
  .drawer-rules-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent-gold);
    margin-bottom: 0.75rem;
  }
  .drawer-rules-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
  }
  @media (min-width: 640px) {
    .drawer-rules-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .rule-contract-card {
    min-width: 0;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 0.65rem 0.85rem;
  }
  .rule-card-top {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.25rem;
  }
  .rule-lvl-tag {
    font-size: 0.68rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }
  .rule-title-text {
    font-size: 0.82rem;
    color: #e2e8f0;
    line-height: 1.4;
  }

  /* Body Layout */
  .reader-body-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .reader-body-layout {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-start;
    }
  }
  .article-body {
    flex-grow: 1;
    max-width: 760px;
    min-width: 0;
  }
  .rendered-markdown {
    scroll-margin-top: 84px;
    font-size: 1.05rem;
    line-height: 1.8;
    color: #cbd5e1;
  }

  /* Pagination */
  .reader-pagination {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }
  .page-nav {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .page-nav:hover {
    border-color: var(--accent-cyan);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .page-nav.next {
    text-align: right;
  }
  .page-dir {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--accent-cyan);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .page-nav.next .page-dir {
    justify-content: flex-end;
  }
  .page-nav-title {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    color: #ffffff;
    font-weight: 600;
    line-height: 1.4;
  }

  /* Sidebar */
  .reader-sidebar {
    width: 100%;
    max-width: 300px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: sticky;
    top: 80px;
  }
  .sidebar-widget {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.25rem;
  }
  .widget-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-cyan);
    margin-bottom: 0.85rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .widget-title {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
    border: none;
    padding: 0;
  }
  .toc-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-height: 380px;
    overflow-y: auto;
  }
  .toc-nav a {
    display: block;
    font-size: 0.82rem;
    color: var(--text-secondary);
