---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { CURATED_LEARNING_PATHS, loadLibraryArticles } from '../../lib/library';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { en } = loadLibraryArticles();
---

<BaseLayout title="Learning Paths — Topological Navigation & Prerequisite Guides" lang="en" alternateUrl={`${base}/zh/paths/`}>
  <div class="paths-page">
    <div class="container">
      <header class="paths-header">
        <span class="paths-tag">PEDAGOGICAL LEARNING PATHS</span>
        <h1 class="paths-title">Systematic Learning Paths</h1>
        <p class="paths-lead">
          All paths are strictly constructed from Frontmatter <code>prerequisites</code> and <code>successors</code> Directed Acyclic Graph (DAG) edges.
          Beyond reading order, each path delivers target audiences, expected outcomes, step objectives, and clear conceptual transitions to the next node.
        </p>
      </header>

      <!-- Learning Paths List (Guided Learning Journey) -->
      <section class="paths-list-section">
        {CURATED_LEARNING_PATHS.map((path, pIdx) => (
          <div class="path-card" id={path.id}>
            <!-- Path Header with Educational Context -->
            <div class="path-header">
              <div class="path-meta-row">
                <span class="path-index">PATH {pIdx + 1}</span>
                <span class="path-badge">{path.badge}</span>
                <span class="path-length-badge">{path.steps.length} Study Modules</span>
              </div>
              <h2 class="path-title">{path.titleEn}</h2>
              <p class="path-desc">{path.descriptionEn}</p>

              <!-- Educational Journey Dossier -->
              <div class="journey-dossier">
                <div class="dossier-card">
                  <div class="dossier-header">
                    <Icon name="academic" size={15} />
                    <span class="dossier-label">Target Audience</span>
                  </div>
                  <p class="dossier-text">{path.targetAudienceEn}</p>
                </div>

                <div class="dossier-card">
                  <div class="dossier-header">
                    <Icon name="shield-check" size={15} />
                    <span class="dossier-label">Learning Outcomes</span>
                  </div>
                  <ul class="dossier-list">
                    {path.learningOutcomesEn.map(item => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>

                <div class="dossier-card">
                  <div class="dossier-header">
                    <Icon name="compass" size={15} />
                    <span class="dossier-label">Starting Volume</span>
                  </div>
                  <p class="dossier-text">
                    <strong>{path.startingVolume}</strong> (Library overview &amp; navigator hub: orient yourself with wing taxonomy, provenance conventions, and DAG dependencies before starting {path.steps[1]?.callNumber || 'LIB-001'})
                  </p>
                </div>
              </div>
            </div>

            <!-- Steps Timeline -->
            <div class="steps-timeline">
              {path.steps.map((step, sIdx) => {
                const article = en.get(step.slug);
                const articleUrl = `${base}/en/notes/${step.slug}/`;
                return (
                  <div class="timeline-step">
                    <div class="step-marker">
                      <span class="step-num">{String(sIdx + 1).padStart(2, '0')}</span>
                      {sIdx < path.steps.length - 1 && <span class="step-line"></span>}
                    </div>

                    <div class="step-content">
                      <div class="step-header">
                        <div class="step-header-left">
                          <span class="step-callno">{step.callNumber}</span>
                          {article && (
                            <span class={`badge-status status-${article.status.toLowerCase().replace(/\s+/g, '-')}`}>
                              {article.status}
                            </span>
                          )}
                          {article && (
                            <span class="step-hall">
                              <Icon name={article.hall.iconName} size={13} />
                              <span>{article.hall.code} {article.hall.nameEn}</span>
                            </span>
                          )}
                        </div>
                      </div>

                      <h3 class="step-title">
                        <a href={articleUrl}>{article ? article.title : step.callNumber}</a>
                      </h3>

                      <p class="step-focus">
                        <strong>Core Study Focus:</strong> {step.focusEn}
                      </p>

                      <div class="step-rationale-box">
                        <div class="rationale-item">
                          <span class="rationale-tag">Step Objective:</span>
                          <span class="rationale-text">{step.objectiveEn}</span>
                        </div>
                        {step.whyNextEn && (
                          <div class="rationale-item rationale-next">
                            <span class="rationale-tag">Why Next Step:</span>
                            <span class="rationale-text">{step.whyNextEn}</span>
                          </div>
                        )}
                      </div>

                      <div class="step-action">
                        <a href={articleUrl} class="btn-step-link">
                          <span>Read Volume</span>
                          <Icon name="arrow-right" size={14} />
                        </a>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </section>

      <!-- Global Roadmap Diagram (Moved to Collapsible Secondary Section) -->
      <section class="roadmap-diagram-section">
        <details class="roadmap-accordion">
          <summary class="roadmap-summary">
            <div class="roadmap-summary-left">
              <Icon name="layers" size={18} />
              <div class="roadmap-summary-text">
                <h2 class="roadmap-title">Global DAG Roadmap Panorama</h2>
                <span class="roadmap-desc">Expand or collapse the full 28-volume topological dependency map.</span>
              </div>
            </div>
            <Icon name="chevron-down" size={18} class="accordion-arrow" />
          </summary>
          <div class="roadmap-card-body">
            <div class="roadmap-img-wrapper">
              <img src={`${base}/assets/00_grand_roadmap.svg`} alt="Global DAG Roadmap" width="100%" />
            </div>
          </div>
        </details>
      </section>

      <!-- Call to Action -->
      <div class="paths-bottom-cta">
        <h3>Looking to explore specific topics?</h3>
        <p>You can also browse the catalog by hall, tag, or call number directly.</p>
        <a href={`${base}/en/library/`} class="btn-primary" style="margin-top: 1rem;">
          <Icon name="book-open" size={16} />
          <span>Browse Catalog (28 Volumes)</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .paths-page {
    padding: 3.5rem 0 5rem;
  }
  .paths-header {
    text-align: center;
    max-width: 780px;
    margin: 0 auto 3.5rem;
  }
  .paths-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-cyan);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.5rem;
  }
  .paths-title {
    font-size: 2.4rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 1rem;
    border-bottom: none;
    padding-bottom: 0;
  }
  .paths-lead {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 0;
  }
  .paths-lead code {
    color: var(--accent-cyan);
  }

  /* Path Cards */
  .paths-list-section {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
    margin-bottom: 4rem;
  }
  .path-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 10px;
    overflow: hidden;
  }
  .path-header {
    padding: 2.25rem 2rem 1.75rem;
    border-bottom: 1px solid var(--border-subtle);
    background-color: rgba(255, 255, 255, 0.01);
  }
  .path-meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }
  .path-index {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-cyan);
    background-color: rgba(56, 189, 248, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(56, 189, 248, 0.25);
  }
  .path-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent-gold);
    background-color: rgba(212, 175, 55, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    border: 1px solid rgba(212, 175, 55, 0.25);
  }
  .path-length-badge {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .path-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
    border-bottom: none;
    padding-bottom: 0;
  }
  .path-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 860px;
  }

  /* Educational Dossier */
  .journey-dossier {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }
  @media (min-width: 768px) {
    .journey-dossier {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .dossier-card {
    min-width: 0;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 1rem;
  }
  .dossier-header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-cyan);
    margin-bottom: 0.4rem;
  }
  .dossier-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #ffffff;
  }
  .dossier-text {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.55;
    margin-bottom: 0;
  }
  .dossier-list {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .dossier-list li {
    margin-bottom: 0.25rem;
  }
  .dossier-list li:last-child {
    margin-bottom: 0;
  }
  .dossier-text strong {
    color: var(--accent-gold);
  }

  /* Timeline */
  .steps-timeline {
    padding: 2rem 2rem 2.5rem;
  }
  .timeline-step {
    display: flex;
    gap: 1.75rem;
    position: relative;
  }
  .step-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }
  .step-num {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--bg-elevated);
    border: 2px solid var(--border-accent);
    color: #ffffff;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .step-line {
    width: 2px;
    flex-grow: 1;
    background-color: var(--border-subtle);
    margin: 0.5rem 0;
    min-height: 48px;
  }
  .step-content {
    flex-grow: 1;
    padding-bottom: 2.25rem;
  }
  .step-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }
  .step-header-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .step-callno {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }
  .step-hall {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .direct-edge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.65rem;
    background-color: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 4px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--accent-cyan);
    margin: 0.4rem 0 0.75rem;
  }
  .direct-edge-pill strong {
    color: #ffffff;
  }
  .step-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }
  .step-title a {
    color: #ffffff;
    text-decoration: none;
  }
  .step-title a:hover {
    color: var(--accent-cyan);
  }
  .step-focus {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.85rem;
  }
  .step-focus strong {
    color: #e2e8f0;
  }
  .step-rationale-box {
    background-color: var(--bg-elevated);
    border-left: 3px solid var(--accent-cyan);
    padding: 0.75rem 1rem;
    border-radius: 0 6px 6px 0;
    margin-bottom: 1rem;
    font-size: 0.82rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .rationale-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  @media (min-width: 640px) {
    .rationale-item {
      flex-direction: row;
      gap: 0.5rem;
    }
  }
  .rationale-tag {
    font-weight: 700;
    color: #ffffff;
    min-width: 100px;
  }
  .rationale-text {
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .rationale-next {
    border-top: 1px dashed var(--border-subtle);
    padding-top: 0.4rem;
  }
  .btn-step-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-cyan);
    text-decoration: none;
  }
  .btn-step-link:hover {
    color: #7dd3fc;
  }

  /* Roadmap Collapsible Accordion */
  .roadmap-diagram-section {
    margin-bottom: 4rem;
  }
  .roadmap-accordion {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    overflow: hidden;
  }
  .roadmap-summary {
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
    user-select: none;
    list-style: none;
  }
  .roadmap-summary::-webkit-details-marker {
    display: none;
  }
  .roadmap-summary-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--accent-cyan);
  }
  .roadmap-summary-text {
    display: flex;
    flex-direction: column;
  }
  .roadmap-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0;
    border: none;
    padding: 0;
  }
  .roadmap-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .accordion-arrow {
    color: var(--text-muted);
    transition: transform 0.2s ease;
  }
  .roadmap-accordion[open] .accordion-arrow {
    transform: rotate(180deg);
  }
  .roadmap-card-body {
    padding: 0 1.5rem 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }
  .roadmap-img-wrapper {
    background-color: #0d121f;
    border-radius: 6px;
    padding: 1rem;
    overflow-x: auto;
  }

  /* Bottom CTA */
  .paths-bottom-cta {
    text-align: center;
    padding: 3rem 1.5rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    max-width: 640px;
    margin: 0 auto;
  }
  .paths-bottom-cta h3 {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    color: #ffffff;
    margin-bottom: 0.5rem;
  }
  .paths-bottom-cta p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  @media (max-width: 639px) {
    .paths-page {
      padding: 1.35rem 0 2.5rem;
    }
    .paths-header {
      margin-bottom: 1.4rem;
    }
    .paths-title {
      font-size: 1.75rem;
      margin-bottom: 0.55rem;
    }
    .paths-lead {
      font-size: 0.92rem;
      line-height: 1.55;
    }
    .paths-list-section {
      gap: 2rem;
      margin-bottom: 2.5rem;
    }
    .path-header {
      padding: 1.15rem 1rem 1rem;
    }
    .path-title {
      font-size: 1.35rem;
      margin-bottom: 0.5rem;
    }
    .path-desc {
      font-size: 0.88rem;
      margin-bottom: 1rem;
    }
    .journey-dossier {
      gap: 0.65rem;
      padding-top: 0.9rem;
    }
    .dossier-card {
      padding: 0.75rem;
    }
    .steps-timeline {
      padding: 1.1rem 1rem 1.25rem;
    }
    .timeline-step {
      gap: 0.8rem;
    }
    .step-num {
      width: 28px;
      height: 28px;
      font-size: 0.76rem;
    }
    .step-content {
      padding-bottom: 1.35rem;
    }
    .step-title {
      font-size: 1.08rem;
    }
    .roadmap-diagram-section {
      margin-bottom: 2rem;
    }
  }
</style>
