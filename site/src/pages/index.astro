---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to Grand Library...</title>
    <meta http-equiv="refresh" content={`0;url=${base}/zh/`} />
    <script define:vars={{ base }}>
      window.location.href = `${base}/zh/`;
    </script>
  </head>
  <body style="background-color: #0b0f19; color: #94a3b8; font-family: sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh;">
    <p>Redirecting to Grand Library... <a href={`${base}/zh/`} style="color: #38bdf8;">Click here if not redirected</a>.</p>
  </body>
</html>
