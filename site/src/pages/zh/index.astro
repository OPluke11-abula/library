---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Icon from '../../components/Icon.astro';
import { KNOWLEDGE_HALLS, loadLibraryArticles } from '../../lib/library';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { zh } = loadLibraryArticles();

const featuredSlugs = ['lib-000', 'lib-001', 'lib-101', 'lib-405', 'lib-501', 'lib-703'];
const featuredArticles = featuredSlugs.map(slug => zh.get(slug)).filter(Boolean);
---

<BaseLayout title="首頁 — 資訊工程與人工智慧雙語知識圖書館" lang="zh" alternateUrl={`${base}/en/`}>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-status-pill">
        <Icon name="shield-check" size={14} />
        <span>學術級資訊工程與人工智慧雙語知識庫 • 形式化合約驗證</span>
      </div>

      <h1 class="hero-title">
        Grand Library<br />
        <span class="hero-subtitle">資訊工程與人工智慧知識圖書館</span>
      </h1>

      <p class="hero-description">
        融合第一性原理空間幾何、嚴格數學推導、GPU 體系結構與現代 AI 代理人協議。專為大學生、專題研究者與高階工程師打造的 reader-first 科技教材。
      </p>

      <!-- Academic Metadata Strip (Retains .metric-card for verified invariants) -->
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-value">28</div>
          <div class="metric-label">核心知識典籍 (Volumes)</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">56</div>
          <div class="metric-label">雙語鏡像研讀篇章</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">104</div>
          <div class="metric-label">系統合約防禦規範</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">10</div>
          <div class="metric-label">專業知識分館 (Halls)</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">20</div>
          <div class="metric-label">直連拓樸相依邊 (DAG)</div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="hero-actions">
        <a href={`${base}/zh/library/`} class="btn-primary">
          <Icon name="book-open" size={16} />
          <span>開始探索知識庫</span>
        </a>
        <a href={`${base}/zh/paths/`} class="btn-secondary">
          <Icon name="layers" size={16} />
          <span>瀏覽系統化學習路徑</span>
        </a>
        <a href={`${base}/zh/notes/lib-001/`} class="btn-outline">
          <Icon name="compass" size={16} />
          <span>第一性原理先修 (LIB-001)</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Curated Reading Entry Showcase -->
  <section class="curated-showcase-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">GUIDED ENTRY</span>
        <h2 class="section-title">基石篇目導讀建議 (Curated Entry Points)</h2>
        <p class="section-desc">若初次研讀，建議由以下四大基石篇目切入，循序建立理論直覺與工程邊界概念。</p>
      </div>

      <div class="showcase-grid">
        <div class="showcase-card">
          <div class="showcase-hall">HALL 00 • 總綱導覽</div>
          <h3 class="showcase-title">
            <a href={`${base}/zh/notes/lib-001/`}>LIB-001 深度學習第一性原理先修精要</a>
          </h3>
          <p class="showcase-rationale">
            <strong>推薦理由：</strong>全館核心必修。從微積分高維幾何出發，建立梯度流動直覺，並給出神經元反向傳播的嚴格收斂性證明。
          </p>
          <a href={`${base}/zh/notes/lib-001/`} class="showcase-link">
            <span>開始研讀</span>
            <Icon name="arrow-right" size={14} />
          </a>
        </div>

        <div class="showcase-card">
          <div class="showcase-hall">HALL 01 • 理論基石</div>
          <h3 class="showcase-title">
            <a href={`${base}/zh/notes/lib-101/`}>LIB-101 高維向量幾何與奇異值分解 (SVD)</a>
          </h3>
          <p class="showcase-rationale">
            <strong>推薦理由：</strong>現代特徵降維與低秩分解的數理本質，直接串接注意力機制運算與 LoRA 權重微調理論。
          </p>
          <a href={`${base}/zh/notes/lib-101/`} class="showcase-link">
            <span>開始研讀</span>
            <Icon name="arrow-right" size={14} />
          </a>
        </div>

        <div class="showcase-card">
          <div class="showcase-hall">HALL 04 • 架構機制</div>
          <h3 class="showcase-title">
            <a href={`${base}/zh/notes/lib-405/`}>LIB-405 Transformer 注意力機制之數學演進</a>
          </h3>
          <p class="showcase-rationale">
            <strong>推薦理由：</strong>深入剖析 Scaled Dot-Product Attention、Softmax 數值防溢出、張量維度對齊與 FlashAttention GPU 運算瓶頸。
          </p>
          <a href={`${base}/zh/notes/lib-405/`} class="showcase-link">
            <span>開始研讀</span>
            <Icon name="arrow-right" size={14} />
          </a>
        </div>

        <div class="showcase-card">
          <div class="showcase-hall">HALL 05 • 空間感知</div>
          <h3 class="showcase-title">
            <a href={`${base}/zh/notes/lib-504/`}>LIB-504 3D 視覺前沿：神經輻射場 (NeRF) 到 3D 高斯潑濺 (3DGS)</a>
          </h3>
          <p class="showcase-rationale">
            <strong>推薦理由：</strong>從連續體積渲染積分到可微分 3D 高斯橢球投影，掌握真實即時神經渲染與 GPU Tile-based 光柵化架構。
          </p>
          <a href={`${base}/zh/notes/lib-504/`} class="showcase-link">
            <span>開始研讀</span>
            <Icon name="arrow-right" size={14} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Knowledge Halls Section -->
  <section class="halls-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">TAXONOMY</span>
        <h2 class="section-title">十大知識分館 (Ten Knowledge Halls)</h2>
        <p class="section-desc">全館按學科內在拓樸結構劃分為十個分館，涵蓋理論、系統、模型、視覺、語言至智慧代理人。</p>
      </div>

      <div class="halls-grid">
        {KNOWLEDGE_HALLS.map(hall => {
          const hallArticles = Array.from(zh.values()).filter(a => a.hall.code === hall.code);
          return (
            <a href={`${base}/zh/library/?hall=${hall.code}`} class="hall-card">
              <div class="hall-card-top">
                <div class="hall-icon-wrapper">
                  <Icon name={hall.iconName} size={20} strokeWidth={2} />
                </div>
                <div class="hall-badge-meta">
                  <span class="hall-code">HALL {hall.code}</span>
                  <span class="hall-count">{hallArticles.length} 篇典籍</span>
                </div>
              </div>
              <div class="hall-meta">
                <h3 class="hall-name">{hall.nameZh}</h3>
                <span class="hall-name-en">{hall.nameEn}</span>
                <p class="hall-desc">{hall.descriptionZh}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Featured Articles Section -->
  <section class="featured-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">CURATED REPOSITORY</span>
        <h2 class="section-title">精選核心典籍 (Featured Articles)</h2>
        <p class="section-desc">嚴謹推導與工程實證兼備的代表性篇目，展示全館知識架構之厚度。</p>
      </div>

      <div class="articles-grid">
        {featuredArticles.map(art => (
          <ArticleCard article={art!} lang="zh" />
        ))}
      </div>

      <div class="featured-all-cta">
        <a href={`${base}/zh/library/`} class="btn-outline">
          <span>查看全部 28 篇典籍</span>
          <Icon name="arrow-right" size={14} />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    padding: 4.5rem 0 3.5rem;
    border-bottom: 1px solid var(--border-subtle);
    background: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.05) 0%, transparent 60%);
  }
  .hero-container {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
  }
  .hero-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    font-size: 0.78rem;
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--accent-cyan);
    background-color: rgba(56, 189, 248, 0.08);
    border: 1px solid rgba(56, 189, 248, 0.25);
    border-radius: 9999px;
    margin-bottom: 1.5rem;
  }
  .hero-title {
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
    color: #ffffff;
    border-bottom: none;
    padding-bottom: 0;
  }
  .hero-subtitle {
    display: block;
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--text-secondary);
    margin-top: 0.5rem;
    font-family: var(--font-sans);
    letter-spacing: 0.02em;
  }
  .hero-description {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 2.5rem;
    padding: 1.25rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
  }
  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .metric-card {
    min-width: 0;
    text-align: center;
    padding: 0.5rem 0.25rem;
  }
  .metric-value {
    font-family: var(--font-mono);
    font-size: 1.5rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }
  .metric-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.3;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .btn-primary, .btn-secondary, .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .btn-primary {
    background-color: var(--accent-cyan);
    color: #0b0f19;
  }
  .btn-primary:hover {
    background-color: #7dd3fc;
    color: #0b0f19;
    text-decoration: none;
  }
  .btn-secondary {
    background-color: var(--bg-surface);
    color: var(--text-primary);
    border: 1px solid var(--border-accent);
  }
  .btn-secondary:hover {
    background-color: var(--bg-elevated);
    border-color: var(--accent-cyan);
    color: #ffffff;
    text-decoration: none;
  }
  .btn-outline {
    background-color: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-subtle);
  }
  .btn-outline:hover {
    color: #ffffff;
    border-color: var(--text-secondary);
    text-decoration: none;
  }

  /* Curated Showcase */
  .curated-showcase-section {
    padding: 4rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 3rem;
  }
  .section-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-cyan);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.5rem;
  }
  .section-title {
    font-size: 1.85rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.75rem;
    border-bottom: none;
    padding-bottom: 0;
  }
  .section-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }
  .showcase-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .showcase-card {
    min-width: 0;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }
  .showcase-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }
  .showcase-hall {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .showcase-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }
  .showcase-title a {
    color: #ffffff;
    text-decoration: none;
  }
  .showcase-title a:hover {
    color: var(--accent-cyan);
  }
  .showcase-rationale {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }
  .showcase-rationale strong {
    color: #e2e8f0;
  }
  .showcase-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-cyan);
    text-decoration: none;
  }
  .showcase-link:hover {
    color: #7dd3fc;
  }

  /* Knowledge Halls */
  .halls-section {
    padding: 4rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .halls-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 640px) {
    .halls-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .halls-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .hall-card {
    min-width: 0;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .hall-card:hover {
    border-color: var(--accent-cyan);
    transform: translateY(-2px);
    text-decoration: none;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
  }
  .hall-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }
  .hall-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 6px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--accent-cyan);
  }
  .hall-badge-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .hall-code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-gold);
    background-color: rgba(212, 175, 55, 0.1);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }
  .hall-count {
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .hall-name {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.2rem;
  }
  .hall-name-en {
    display: block;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }
  .hall-desc {
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0;
  }

  /* Featured Section */
  .featured-section {
    padding: 4rem 0 5rem;
  }
  .articles-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    .articles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .featured-all-cta {
    text-align: center;
  }

  @media (max-width: 639px) {
    .hero-section {
      padding: 1.5rem 0 1.75rem;
    }
    .hero-status-pill {
      font-size: 0.72rem;
      padding: 0.25rem 0.65rem;
      margin-bottom: 0.85rem;
    }
    .hero-title {
      font-size: 2rem;
      margin-bottom: 0.65rem;
    }
    .hero-subtitle {
      font-size: 1.05rem;
      margin-top: 0.35rem;
    }
    .hero-description {
      font-size: 0.92rem;
      line-height: 1.55;
      margin-bottom: 1.15rem;
    }
    .metrics-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.45rem;
      padding: 0.65rem;
      margin-bottom: 1.15rem;
    }
    .metric-card {
      padding: 0.25rem 0.15rem;
    }
    .metric-value {
      font-size: 1.2rem;
      margin-bottom: 0.15rem;
    }
    .hero-actions {
      gap: 0.55rem;
    }
    .btn-primary, .btn-secondary, .btn-outline {
      width: 100%;
      justify-content: center;
      padding: 0.55rem 1rem;
    }
    .curated-showcase-section, .halls-section, .featured-section {
      padding: 2.25rem 0;
    }
    .section-header {
      margin-bottom: 1.5rem;
    }
  }
</style>
