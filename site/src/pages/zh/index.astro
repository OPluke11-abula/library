---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { KNOWLEDGE_HALLS, loadLibraryArticles } from '../../lib/library';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { zh } = loadLibraryArticles();

const featuredSlugs = ['lib-000', 'lib-001', 'lib-101', 'lib-501', 'lib-703', 'lib-901'];
const featuredArticles = featuredSlugs.map(slug => zh.get(slug)).filter(Boolean);
---

<BaseLayout title="首頁 — 資訊工程與人工智慧雙語知識圖書館" lang="zh">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span>RESEARCH KNOWLEDGE BASE • 104 SYSTEM INVARIANTS</span>
      </div>

      <h1 class="hero-title">
        Grand Library<br />
        <span class="hero-subtitle">資訊工程與人工智慧雙語知識圖書館</span>
      </h1>

      <p class="hero-description">
        結合概念與物理動機、數學形式化嚴格推導、GPU 體系結構與硬體對齊，以及生產級工程邊界規範的深度學習知識地圖。專為資工系大學生、專題研究者與自主 AI 代理人打造。
      </p>

      <!-- Key Metrics -->
      <div class="metrics-grid">
        <div class="metric-card">
          <div class="metric-value">28</div>
          <div class="metric-label">核心知識典籍 (Volumes)</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">56</div>
          <div class="metric-label">中英雙語鏡像對稱頁面</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">104</div>
          <div class="metric-label">形式化合約規範 (Invariants)</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">10</div>
          <div class="metric-label">跨領域知識分館 (Halls)</div>
        </div>
        <div class="metric-card">
          <div class="metric-value">100%</div>
          <div class="metric-label">有向無環拓樸 (DAG Verified)</div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="hero-actions">
        <a href={`${base}/zh/library/`} class="btn-primary">
          <span>📚 探索典籍目錄</span>
        </a>
        <a href={`${base}/zh/paths/`} class="btn-secondary">
          <span>🧭 進入學習路徑</span>
        </a>
        <a href={`${base}/zh/notes/lib-001/`} class="btn-outline">
          <span>⚡ 第一性原理先修 (LIB-001)</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Knowledge Halls Section -->
  <section class="halls-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">CLASSIFICATION</span>
        <h2 class="section-title">十大知識分館 (Ten Knowledge Halls)</h2>
        <p class="section-desc">涵蓋由理論數學基石、計算機體系底層，延伸至現代神經網路架構與頂尖專題研究之知識體系。</p>
      </div>

      <div class="halls-grid">
        {KNOWLEDGE_HALLS.map(hall => (
          <a href={`${base}/zh/library/?hall=${hall.code}`} class="hall-card">
            <div class="hall-icon">{hall.icon}</div>
            <div class="hall-meta">
              <span class="hall-code">HALL {hall.code}</span>
              <h3 class="hall-name">{hall.nameZh}</h3>
              <p class="hall-desc">{hall.descriptionZh}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Architecture Visual Blueprint -->
  <section class="blueprint-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">FOUNDATIONAL BLUEPRINT</span>
        <h2 class="section-title">深度學習第一性原理導覽地圖</h2>
        <p class="section-desc">從高維幾何變換、前向傳播、損失度量到反向傳播連鎖律與硬體對齊之動態管線。</p>
      </div>

      <div class="blueprint-viewer">
        <img src={`${base}/assets/01_principles_navigator.svg`} alt="深度學習核心原理導覽" width="100%" loading="lazy" />
      </div>
    </div>
  </section>

  <!-- Featured Articles Section -->
  <section class="featured-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">CORE CURATION</span>
        <h2 class="section-title">精選核心典籍 (Featured Articles)</h2>
        <p class="section-desc">圖書館推薦之必讀篇目，每篇均具備嚴格數學形式化推導與真實工程防禦規則。</p>
      </div>

      <div class="articles-grid">
        {featuredArticles.map(art => (
          <ArticleCard article={art!} lang="zh" />
        ))}
      </div>

      <div class="section-cta">
        <a href={`${base}/zh/library/`} class="btn-primary">
          <span>查看全部 28 篇核心典籍 →</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero-section {
    padding: 4.5rem 0 3.5rem;
    background: radial-gradient(circle at 50% 20%, rgba(30, 41, 59, 0.4) 0%, rgba(11, 15, 25, 0.95) 70%);
    border-bottom: 1px solid var(--border-subtle);
  }
  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.85rem;
    font-size: 0.75rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--accent-gold);
    background-color: rgba(212, 175, 55, 0.1);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: 9999px;
    margin-bottom: 1.5rem;
    letter-spacing: 0.08em;
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    background-color: var(--accent-gold);
    border-radius: 50%;
    box-shadow: 0 0 8px var(--accent-gold);
  }
  .hero-title {
    font-size: 2.8rem;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1.25rem;
    color: #ffffff;
    border: none;
    padding: 0;
  }
  .hero-subtitle {
    font-size: 1.6rem;
    color: var(--accent-gold);
    font-weight: 600;
    display: block;
    margin-top: 0.5rem;
  }
  @media (min-width: 768px) {
    .hero-title { font-size: 3.5rem; }
    .hero-subtitle { font-size: 1.9rem; }
  }
  .hero-description {
    max-width: 780px;
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    width: 100%;
    max-width: 900px;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .metric-card {
    background-color: rgba(18, 24, 38, 0.7);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1rem 0.75rem;
  }
  .metric-value {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.25rem;
  }
  .metric-label {
    font-size: 0.72rem;
    color: var(--text-muted);
    line-height: 1.3;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  .btn-primary, .btn-secondary, .btn-outline {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.4rem;
    border-radius: 6px;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .btn-primary {
    background-color: var(--accent-gold);
    color: #0b0f19 !important;
  }
  .btn-primary:hover {
    background-color: var(--accent-gold-hover);
    transform: translateY(-1px);
  }
  .btn-secondary {
    background-color: var(--bg-surface);
    color: var(--text-primary) !important;
    border: 1px solid var(--border-subtle);
  }
  .btn-secondary:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold) !important;
  }
  .btn-outline {
    background: transparent;
    color: var(--accent-cyan) !important;
    border: 1px solid rgba(56, 189, 248, 0.4);
  }
  .btn-outline:hover {
    background-color: rgba(56, 189, 248, 0.1);
  }

  /* Section Common */
  .section-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2.5rem;
  }
  .section-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 0.4rem;
  }
  .section-title {
    font-size: 1.85rem;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 0.6rem;
    border: none;
    padding: 0;
  }
  .section-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  /* Halls */
  .halls-section {
    padding: 4.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .halls-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
    .halls-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .halls-grid { grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
  }
  .hall-card {
    display: flex;
    gap: 1.25rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.4rem;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .hall-card:hover {
    border-color: var(--accent-gold);
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.3);
  }
  .hall-icon {
    font-size: 2rem;
    line-height: 1;
    flex-shrink: 0;
  }
  .hall-code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-gold);
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.2rem;
  }
  .hall-name {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 0.4rem;
  }
  .hall-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Blueprint */
  .blueprint-section {
    padding: 4.5rem 0;
    background-color: rgba(18, 24, 38, 0.4);
    border-bottom: 1px solid var(--border-subtle);
  }
  .blueprint-viewer {
    background-color: #0d121f;
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1.5rem;
    overflow-x: auto;
  }

  /* Featured */
  .featured-section {
    padding: 4.5rem 0;
  }
  .articles-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    .articles-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .articles-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .section-cta {
    text-align: center;
  }
</style>
