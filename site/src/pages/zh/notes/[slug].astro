---
import ReaderPage from '../../../components/ReaderPage.astro';
import { loadLibraryArticles, type ArticleData } from '../../../lib/library';

export async function getStaticPaths() {
  const { zh } = loadLibraryArticles();
  return Array.from(zh.values()).map(article => ({
    params: { slug: article.slug },
    props: { article }
  }));
}

interface Props {
  article: ArticleData;
}

const { article } = Astro.props;
---

<ReaderPage article={article} lang="zh" />
